local function buildScript(name, macroJson, autoJoin)
    local path = exportPath(name)
    local cfg = {
        "-- Doomspire Defense auto-farm, generated by TD Macro Hub",
        "-- Macro '" .. safeName(name) .. "' is embedded below. Run it with:",
        "--   loadstring(readfile(" .. string.format("%q", path) .. "))()",
        "",
        "local API_URL = " .. ser(API_URL),
        "local SCRIPT_PATH = " .. ser(path),
        "local MACRO_NAME = " .. ser(safeName(name)),
        "local MACRO_JSON = " .. string.format("%q", macroJson),
        "",
        "local VOTE = " .. ser(S.exportStart),
        "local MODE = " .. ser(S.mode),
        "local RETRIES = " .. ser(S.retries),
        "local CHECK_MONEY = " .. ser(S.checkMoney),
        "local REQUIRE_LOADOUT = " .. ser(S.requireLoadout),
        "local REPAIR = " .. ser(S.repair),
        "local REPAIR_OPTIONS = " .. ser(repairOptions()),
        "local DELAYS = " .. ser(delayOptions()),
        "local AUTO_JOIN = " .. (autoJoin and ser(autoJoin) or "nil"),
        "",
    }
    return table.concat(cfg, "\n") .. "\n" .. SCRIPT_BODY
end


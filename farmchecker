--[[
    Doomspire Defense - Game Stats Tracker

    Tracks Bricks, Bux, XP, run time, runs completed and per-hour rewards.

    Discord (optional):
        _G.DiscordWebhook = "https://discord.com/api/webhooks/..."
        Leave empty = Discord disabled. Set it BEFORE running this script.

    Failsafe:
        Failed Discord sends are saved to TDMacros/GameStats/GameStats.json
        and retried automatically after the next successful send.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer
local env = (getgenv and getgenv()) or _G

-- re-running the script replaces the old tracker instead of doubling it up
if env.TD_STATS_CLEANUP then
    pcall(env.TD_STATS_CLEANUP)
end

_G.DiscordWebhook = _G.DiscordWebhook or ""

---------------------------------------------------------------------
-- Configuration
---------------------------------------------------------------------
local STATS_PATH = "TDMacros/GameStats"
local STATS_FILE = STATS_PATH .. "/GameStats.json"

local CHECK_INTERVAL = 0.1
local STABLE_CHECKS  = 5   -- values must be unchanged this many checks (~0.5s) before counting
local MAX_RETRIES_PER_SEND = 5

local function webhookUrl()
    local url = _G.DiscordWebhook
    if type(url) == "string" and url ~= "" then return url end
end

---------------------------------------------------------------------
-- UI
---------------------------------------------------------------------
local function getUI()
    local PlayerGui = Player:FindFirstChild("PlayerGui")
    local GameGUI = PlayerGui and PlayerGui:FindFirstChild("GameGUI")
    local EndScreen = GameGUI and GameGUI:FindFirstChild("EndScreen")
    if not EndScreen then return nil end

    local Rewards = EndScreen:FindFirstChild("Rewards")
    local Stats = EndScreen:FindFirstChild("Stats")
    if not Rewards or not Stats then return nil end

    local RewardsList = Rewards:FindFirstChild("RewardsList")
    local function amount(name)
        local item = RewardsList and RewardsList:FindFirstChild(name)
        return item and item:FindFirstChild("Amount")
    end

    local Bricks, Bux, XP = amount("Bricks"), amount("Bux"), amount("XP")
    local Time = Stats:FindFirstChild("Time")
    if not Bricks or not Bux or not XP or not Time then return nil end

    return { EndScreen = EndScreen, Bricks = Bricks, Bux = Bux, XP = XP, Time = Time }
end

-- true only if the object and all its ancestors are actually visible
local function isShown(obj)
    local current = obj
    while current and current ~= Player do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("LayerCollector") and not current.Enabled then return false end
        current = current.Parent
    end
    return true
end

---------------------------------------------------------------------
-- File system
---------------------------------------------------------------------
local function ensureFolder()
    if not (isfolder and makefolder) then return false end
    if not isfolder("TDMacros") then makefolder("TDMacros") end
    if not isfolder(STATS_PATH) then makefolder(STATS_PATH) end
    return true
end

ensureFolder()

local function readStatsFile()
    local empty = { FailedWebhooks = {} }
    if not (isfile and readfile) or not isfile(STATS_FILE) then return empty end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(STATS_FILE))
    end)

    if ok and type(data) == "table" then
        data.FailedWebhooks = data.FailedWebhooks or {}
        return data
    end
    return empty
end

local function saveStatsFile(data)
    if not writefile then return false end
    ensureFolder()
    return (pcall(function()
        writefile(STATS_FILE, HttpService:JSONEncode(data))
    end))
end

local function saveFailedWebhook(payload, errorMessage)
    local data = readStatsFile()
    table.insert(data.FailedWebhooks, {
        Timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        Error = tostring(errorMessage or "Unknown error"),
        Payload = payload,
    })
    saveStatsFile(data)
    warn("[GameStats] Discord send failed - saved to GameStats.json")
end

---------------------------------------------------------------------
-- HTTP
---------------------------------------------------------------------
local requestFunction =
    (syn and syn.request)
    or (http and http.request)
    or http_request
    or request

-- returns ok, errorMessage (does not save anything)
local function postWebhook(payload)
    local url = webhookUrl()
    if not url then return true end
    if not requestFunction then return false, "No HTTP request function available" end

    local ok, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload),
        })
    end)

    if not ok then return false, response end

    local code = response and response.StatusCode
    if code and (code < 200 or code >= 300) then
        return false, "HTTP " .. tostring(code)
    end
    return true
end

local function sendWebhook(payload)
    if not webhookUrl() then return true end
    local ok, err = postWebhook(payload)
    if not ok then saveFailedWebhook(payload, err) end
    return ok
end

-- re-send anything that failed earlier; keep whatever still fails
local function retryFailedWebhooks()
    if not webhookUrl() then return end
    local data = readStatsFile()
    if #data.FailedWebhooks == 0 then return end

    local remaining, tried = {}, 0
    for _, item in ipairs(data.FailedWebhooks) do
        if tried < MAX_RETRIES_PER_SEND and type(item.Payload) == "table" then
            tried += 1
            if not postWebhook(item.Payload) then table.insert(remaining, item) end
            task.wait(1) -- stay under Discord's rate limit
        else
            table.insert(remaining, item)
        end
    end

    data.FailedWebhooks = remaining
    saveStatsFile(data)
end

---------------------------------------------------------------------
-- Parsing
---------------------------------------------------------------------
-- Supports: 1,234   500   1.5K   2.3M   4B   "+500 Bux"
local function parseNumber(value)
    if value == nil then return 0 end

    local text = tostring(value):gsub(",", "")

    -- suffix must not be the start of a word ("500 Bux" is 500, not 500B)
    local num, suffix = text:match("(-?%d+%.?%d*)%s?([KkMmBb])%f[%A]")
    if not num then
        num, suffix = text:match("(-?%d+%.?%d*)"), ""
    end

    local multiplier = ({ K = 1e3, M = 1e6, B = 1e9 })[suffix:upper()] or 1
    return (tonumber(num) or 0) * multiplier
end

-- Supports: 1:12:34   12:34   1m 30s   12.5   "12 seconds"
local function parseTime(value)
    if value == nil then return 0 end
    local text = tostring(value)

    local h, m, s = text:match("(%d+):(%d+):(%d+)")
    if h then return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(s) end

    m, s = text:match("(%d+):(%d+)")
    if m then return tonumber(m) * 60 + tonumber(s) end

    m, s = text:match("(%d+)%s*m%a*%s*(%d+)%s*s")
    if m then return tonumber(m) * 60 + tonumber(s) end

    return tonumber(text:match("%d+%.?%d*")) or 0
end

---------------------------------------------------------------------
-- Formatting
---------------------------------------------------------------------
local function formatNumber(number)
    local formatted = tostring(math.floor(number + 0.5))
    while true do
        local new, count = formatted:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        formatted = new
        if count == 0 then break end
    end
    return formatted
end

local function formatTime(totalSeconds)
    totalSeconds = math.floor(totalSeconds)
    local hours = math.floor(totalSeconds / 3600)
    local minutes = math.floor((totalSeconds % 3600) / 60)
    local seconds = totalSeconds % 60

    if hours > 0 then
        return string.format("%d:%02d:%02d", hours, minutes, seconds)
    end
    return string.format("%02d:%02d", minutes, seconds)
end

---------------------------------------------------------------------
-- Run handling
---------------------------------------------------------------------
local RunCount = 0

local function handleRun(bricks, bux, xp, runTime)
    RunCount += 1
    local runNumber = RunCount

    local hours = runTime / 3600
    local bricksPerHour = bricks / hours
    local buxPerHour = bux / hours
    local xpPerHour = xp / hours

    print("")
    print("========================================")
    print("[GameStats] RUN #" .. runNumber)
    print("========================================")
    print("Time:   " .. formatTime(runTime))
    print("")
    print("Rewards:")
    print("  Bricks: " .. formatNumber(bricks))
    print("  Bux:    " .. formatNumber(bux))
    print("  XP:     " .. formatNumber(xp))
    print("")
    print("Per Hour:")
    print("  Bricks: " .. formatNumber(bricksPerHour) .. "/hr")
    print("  Bux:    " .. formatNumber(buxPerHour) .. "/hr")
    print("  XP:     " .. formatNumber(xpPerHour) .. "/hr")
    print("")
    print("Total Runs: #" .. runNumber)
    print("========================================")

    if not webhookUrl() then return end

    local payload = {
        username = "Doomspire Farm",
        embeds = {{
            title = "Doomspire Defense — Run #" .. runNumber,
            fields = {
                { name = "⏱️ Run Time", value = formatTime(runTime), inline = true },
                {
                    name = "📦 Rewards",
                    value = "🧱 Bricks: **" .. formatNumber(bricks) .. "**\n"
                        .. "💰 Bux: **" .. formatNumber(bux) .. "**\n"
                        .. "⭐ XP: **" .. formatNumber(xp) .. "**",
                    inline = true,
                },
                {
                    name = "📈 Per Hour",
                    value = "🧱 Bricks: **" .. formatNumber(bricksPerHour) .. "/hr**\n"
                        .. "💰 Bux: **" .. formatNumber(buxPerHour) .. "/hr**\n"
                        .. "⭐ XP: **" .. formatNumber(xpPerHour) .. "/hr**",
                    inline = false,
                },
                { name = "🔄 Runs", value = "#" .. runNumber, inline = true },
            },
            footer = { text = "Doomspire Defense Farm" },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }},
    }

    -- HTTP yields, so never block the render step
    task.spawn(function()
        if sendWebhook(payload) then
            print("[GameStats] Discord webhook sent.")
            retryFailedWebhooks()
        end
    end)
end

---------------------------------------------------------------------
-- PreRender monitoring
-- A run counts once per time the EndScreen is shown, after its values have
-- settled. It re-arms when the EndScreen is hidden again (next round), so two
-- runs with identical numbers are still counted separately.
---------------------------------------------------------------------
local processed = false
local stableId, stableCount = nil, 0
local lastCheck = 0

local function check()
    local ui = getUI()

    if not ui or not isShown(ui.EndScreen) then
        processed, stableId, stableCount = false, nil, 0
        return
    end

    if processed then return end

    local runTime = parseTime(ui.Time.Text)
    if runTime <= 0 then return end -- not loaded / stale

    local bricks = parseNumber(ui.Bricks.Text)
    local bux = parseNumber(ui.Bux.Text)
    local xp = parseNumber(ui.XP.Text)

    local id = runTime .. ":" .. bricks .. ":" .. bux .. ":" .. xp
    if id == stableId then
        stableCount += 1
    else
        stableId, stableCount = id, 1 -- values still counting up / changing
    end

    if stableCount >= STABLE_CHECKS then
        processed = true
        handleRun(bricks, bux, xp, runTime)
    end
end

local connection = RunService.PreRender:Connect(function()
    local now = os.clock()
    if now - lastCheck < CHECK_INTERVAL then return end
    lastCheck = now

    local ok, err = pcall(check)
    if not ok then warn("[GameStats] check error: " .. tostring(err)) end
end)

env.TD_STATS_CLEANUP = function()
    pcall(function() connection:Disconnect() end)
    env.TD_STATS_CLEANUP = nil
end

print("[GameStats] Tracker started.")
print("[GameStats] Discord:", webhookUrl() and "Enabled" or "Disabled")

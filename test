local function advanceToNextStage()
    local completedStage = StageQueue[currentStageIndex]
    print(string.format("[STAGE] Completed %s Stage %d | %s | EXP: %.0f", 
        completedStage.Chapter, completedStage.Stage, getStarsDisplay(completedStage.Stars), currentStageEXP))
    
    sendWebhook(currentStageEXP, completedStage)
    Stats.CyclesCompleted = Stats.CyclesCompleted + 1
    
    currentStageIndex = currentStageIndex + 1
    currentStageWins = 0
    currentStageEXP = 0
    
    if currentStageIndex > #StageQueue then
        allStagesComplete = true
        print("========================================")
        print("   ✅ ALL STAGES COMPLETE! ✅")
        print("========================================")
        sendCompletionWebhook()
        
        -- Reset for next run if script is re-executed
        Stats.CurrentStageIndex = 1
        Stats.CurrentStageWins = 0
        Stats.CurrentStageEXP = 0
        saveStats()
        rejoin()
        return
    end
    
    local nextStage = StageQueue[currentStageIndex]
    print(string.format("[NEXT] Moving to %s Stage %d | %s | Need %d wins", 
        nextStage.Chapter, nextStage.Stage, getStarsDisplay(nextStage.Stars), nextStage.WinsNeeded))
    
    saveStats()
end


-- Step list
---------------------------------------------------------------------
local rows = {}

local function makeRow(i)
    local b = make("TextButton", {
        Size = UDim2.new(1, -8, 0, 20), BackgroundColor3 = C.row, BorderSizePixel = 0, AutoButtonColor = true,
        Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.text,
        Text = "", LayoutOrder = i, ClipsDescendants = true,
    }, stepList)
    b.MouseButton1Click:Connect(function()
        local e = entries()[i]
        if e then selectEntry(e) end
    end)
    return b
end

local function syncRows(pb)
    local list = entries()
    while #rows < #list do table.insert(rows, makeRow(#rows + 1)) end
    while #rows > #list do rows[#rows]:Destroy() rows[#rows] = nil end

    local live = pb.Playing and view.live and pb.Macro == view.macro
    local idx = live and pb.Index or nil

    for i, e in ipairs(list) do
        local row = rows[i]
        local icon, color = "  ", C.text
        local res = pb.Results and pb.Results[e]

        if e.disabled then
            icon, color = "o ", C.skip
        elseif idx and i == idx then
            icon, color = ">>", C.cur
        elseif res then
            if res.reason == "skipped" then icon, color = "- ", C.skip
            elseif res.ok then icon, color = "ok", C.ok
            else icon, color = "XX", C.bad end
        elseif idx and i < idx then
            icon, color = "ok", C.ok
        end

        local eta = ""
        if idx and i >= idx and e.t and pb.Timed and not e.disabled then
            eta = string.format("  in %.1fs", math.max(0, e.t - pb.Elapsed))
        end
        local why = (res and not res.ok and res.reason) and ("  (" .. tostring(res.reason) .. ")") or ""

        row.Text = string.format(" %s %02d [%6.1fs] %s%s%s", icon, i, e.t or 0, describe(e), eta, why)
        row.TextColor3 = color
        row.BackgroundColor3 = (e == view.selected) and C.sel or C.row
    end
end

---------------------------------------------------------------------
-- Backups list
---------------------------------------------------------------------
local function restoreBackup(item)
    if not view.macro or not view.name then return end
    if not readfile then return end

    -- preserve both the on-disk version and any unsaved in-memory edits first
    backupDiskVersion(view.name)
    local okEnc, memJson = pcall(function() return HttpService:JSONEncode(view.macro) end)
    if okEnc then writeBackupRaw(view.name, memJson) end

    local okDec, data = pcall(function() return HttpService:JSONDecode(readfile(item.path)) end)
    if not okDec or type(data) ~= "table" or type(data.entries) ~= "table" then
        say("That backup is corrupt.", C.bad)
        return
    end

    -- replace contents in place: a replay in progress keeps iterating the same table
    for k in pairs(view.macro) do view.macro[k] = nil end
    for k, v in pairs(data) do view.macro[k] = v end
    view.selected = nil
    selectEntry(nil)

    if TD.SaveMacro(view.name, view.macro).Success then
        view.dirty = false
        say("Restored " .. item.label .. " (previous state backed up).", C.ok)
    end
end

local function rebuildBackups()
    for _, c in ipairs(backupList:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
    end
    if not view.name then
        label(backupList, "  No macro file selected.", UDim2.new(), UDim2.new(1, 0, 0, 20))
        return
    end
    local list = listBackups(view.name)
    if #list == 0 then
        label(backupList, "  No backups yet for '" .. view.name .. "'. One is created on every change.", UDim2.new(), UDim2.new(1, 0, 0, 20))
        return
    end
    for i, item in ipairs(list) do
        local steps = "?"
        pcall(function()
            steps = #HttpService:JSONDecode(readfile(item.path)).entries
        end)
        local b = make("TextButton", {
            Size = UDim2.new(1, -8, 0, 22), BackgroundColor3 = C.row, BorderSizePixel = 0, LayoutOrder = i,
            Font = Enum.Font.Code, TextSize = 12, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
            Text = string.format("  %s   (%s steps)   - click to restore", item.label, tostring(steps)),
        }, backupList)
        b.MouseButton1Click:Connect(function()
            restoreBackup(item)
            rebuildBackups()
        end)
    end
end

---------------------------------------------------------------------
-- Buttons
---------------------------------------------------------------------
local function macroNames() return TD.ListMacros() end

local function cycle(dir)
    local pb = playback()
    if pb.Playing then say("A macro is playing - showing the live macro.", C.cur) return end
    local names = macroNames()
    if #names == 0 then say("No saved macros.", C.bad) return end
    local cur = 1
    for i, n in ipairs(names) do if n == view.name then cur = i end end
    cur = ((cur - 1 + dir) % #names) + 1
    loadMacroByName(names[cur])
    selectEntry(nil)
    if view.showBackups then rebuildBackups() end
end

prevBtn.MouseButton1Click:Connect(function() cycle(-1) end)
nextBtn.MouseButton1Click:Connect(function() cycle(1) end)

autoBtn.MouseButton1Click:Connect(function()
    view.autosave = not view.autosave
end)

pauseBtn.MouseButton1Click:Connect(function()
    local pb = playback()
    if not pb.Playing then return end
    TD.PausePlayback(not pb.Paused)
end)
skipBtn.MouseButton1Click:Connect(function()
    if playback().Playing then TD.SkipStep() say("Skipping current step.", C.cur) end
end)
stopBtn.MouseButton1Click:Connect(function() TD.Stop() end)
saveBtn.MouseButton1Click:Connect(function() saveMacro(false) end)
bkBtn.MouseButton1Click:Connect(function()
    view.showBackups = not view.showBackups
    stepList.Visible = not view.showBackups
    backupList.Visible = view.showBackups
    if view.showBackups then rebuildBackups() end
end)

---------------------------------------------------------------------
-- Update loop
---------------------------------------------------------------------
local lastTick = 0

local function update()
    local pb = playback()

    -- bind to the macro being replayed
    if pb.Playing and pb.Macro and view.macro ~= pb.Macro then
        if view.dirty and view.name then say("Unsaved edits to the previous copy were discarded.", C.cur) end
        view.macro, view.name, view.live, view.selected, view.dirty = pb.Macro, pb.Name, true, nil, false
        view.lastIndex = nil
        selectEntry(nil)
        if view.showBackups then rebuildBackups() end
    elseif not view.macro then
        local names = macroNames()
        if names[1] then loadMacroByName(names[1]) end
    end

    local live = pb.Playing and view.live and pb.Macro == view.macro

    -- header
    local state = live and (pb.Paused and "PAUSED" or "PLAYING") or "idle"
    statusLabel.Text = live
        and string.format("%s  step %d/%d  |  %s  |  t=%.1fs", state, pb.Index, pb.Total, tostring(pb.Status), pb.Elapsed)
        or string.format("%s  |  %s", state, view.macro and (#view.macro.entries .. " steps") or "no macro")

    if live then
        local e = view.macro.entries[pb.Index]
        if e then
            local eta = (pb.Timed and e.t) and string.format("  in %.1fs", math.max(0, e.t - pb.Elapsed)) or ""
            nextLabel.Text = string.format("NEXT %d: %s%s%s", pb.Index, describe(e), eta, e.disabled and "  [disabled]" or "")
        else
            nextLabel.Text = "NEXT: (end of macro)"
        end
    else
        nextLabel.Text = pb.Status and ("last status: " .. tostring(pb.Status)) or "NEXT: -"
    end

    macroLabel.Text = (view.name or "(unsaved macro)") .. (view.dirty and " *" or "") .. (live and "  [live]" or "")
    autoBtn.Text = "Auto-save: " .. (view.autosave and "ON" or "OFF")
    autoBtn.BackgroundColor3 = view.autosave and C.btnOn or C.btn
    pauseBtn.Text = (live and pb.Paused) and "Resume" or "Pause"
    pauseBtn.BackgroundColor3 = (live and pb.Paused) and C.btnOn or C.btn
    bkBtn.Text = view.showBackups and "Back to steps" or "Backups"

    if not view.showBackups then
        syncRows(pb)
        -- follow the replay
        if live and view.lastIndex ~= pb.Index then
            view.lastIndex = pb.Index
            stepList.CanvasPosition = Vector2.new(0, math.max(0, (pb.Index - 4) * 21))
        end
    end
end

connect(RunService.Heartbeat, function()
    gui.Enabled = env.ReplayUI == true
    if not gui.Enabled then return end
    local now = os.clock()
    if now - lastTick < 0.1 then return end
    lastTick = now
    local ok, err = pcall(update)
    if not ok then warn("[ReplayUI] " .. tostring(err)) end
end)

env.ReplayUIDestroy = function()
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
    pcall(function() gui:Destroy() end)
    env.ReplayUIDestroy = nil
end

selectEntry(nil)
print("[ReplayUI] Loaded. Toggle with getgenv().ReplayUI = true/false")

-- ============ UTILITY FUNCTIONS ============
local function getAverageEXP()
    if #Stats.RecentEXP == 0 then return 0 end
    local sum = 0
    for _, exp in ipairs(Stats.RecentEXP) do
        sum = sum + exp
    end
    return math.floor(sum / #Stats.RecentEXP)
end

local function formatRuntime(seconds)
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hours, minutes, secs)
end

local function getWinRate()
    if Stats.BattlesCompleted == 0 then return "0%" end
    return string.format("%.1f%%", (Stats.Wins / Stats.BattlesCompleted) * 100)
end

local function getEXPPerHour()
    local runtime = tick() - Stats.OverallStartTime
    if runtime < 60 then return 0 end
    return math.floor((Stats.TotalEXP / runtime) * 3600)
end

local function getCurrentStageInfo()
    if currentStageIndex > #StageQueue then return nil end
    return StageQueue[currentStageIndex]
end

local function getStarsDisplay(stars)
    return string.rep("★", stars) .. string.rep("☆", 3 - stars)
end

local function getServerRuntime() return tick() - serverJoinTime end
local function getOverallRuntime() return tick() - Stats.OverallStartTime end


---------------------------------------------------------------------
-- Wait until everything is loaded
---------------------------------------------------------------------

local function waitUntilFullyLoaded()
    if not TD.IsGame() then
        return
    end

    local char = LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()

    char:WaitForChild("HumanoidRootPart", 15)

    local hum = char:WaitForChild("Humanoid", 15)

    if hum then
        while alive() and hum.Health <= 0 do
            task.wait(0.2)
        end
    end

    local Events = ReplicatedStorage:WaitForChild("Events", 30)

    Events
        :WaitForChild("Game", 30)
        :WaitForChild("StartGame", 30)

    workspace:WaitForChild("Towers", 30)

    LocalPlayer
        :WaitForChild("PlayerGui")
        :WaitForChild("GameGUI", 30)

    task.wait(1)
end

---------------------------------------------------------------------
-- Start game / vote
---------------------------------------------------------------------

local function startGameMode()
    if VOTE == "Start" then
        local StartGame = ReplicatedStorage
            :WaitForChild("Events")
            :WaitForChild("Game")
            :WaitForChild("StartGame")

        StartGame:FireServer()

        print("[TD Farm] Fired StartGame remote.")
    else
        TD.Vote(VOTE)

        print("[TD Farm] Voted: " .. tostring(VOTE))
    end
end

---------------------------------------------------------------------
-- One round
---------------------------------------------------------------------

local farming = false

local function startRound()
    if farming or not alive() or not TD.IsGame() then
        return
    end

    farming = true

    waitUntilFullyLoaded()

    if not alive() or not TD.IsGame() then
        farming = false
        return
    end

    -----------------------------------------------------------------
    -- Start game / vote
    -----------------------------------------------------------------

    startGameMode()

    task.wait(1)

    -----------------------------------------------------------------
    -- Play macro
    -----------------------------------------------------------------

    local playDone = false

    local r = TD.Play(MACRO, {
        Mode = "Timed",

        OnDone = function()
            playDone = true
        end,
    })

    if not r.Success then
        warn(
            "[TD Farm] Play failed: "
            .. tostring(r.Error)
            .. " ["
            .. tostring(r.Code)
            .. "]"
        )

        TD.Notify(
            "Auto-farm: " .. tostring(r.Error),
            Color3.new(1, 0, 0)
        )

        farming = false
        return
    end

    -----------------------------------------------------------------
    -- Wait for macro to finish
    -----------------------------------------------------------------

    while alive()
        and not playDone
        and TD.IsPlaying()
    do
        task.wait(0.5)
    end

    farming = false
end

---------------------------------------------------------------------
-- Main startup
---------------------------------------------------------------------

task.spawn(function()
    waitUntilFullyLoaded()

    if not alive() or not TD.IsGame() then
        return
    end

    startRound()

    -----------------------------------------------------------------
    -- Get EndScreen
    -----------------------------------------------------------------

    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
    local GameGUI = PlayerGui:WaitForChild("GameGUI")
    local EndScreen = GameGUI:WaitForChild("EndScreen")

    local Win = EndScreen:WaitForChild("Win")
    local Lose = EndScreen:WaitForChild("Lose")

    local restarting = false

    -----------------------------------------------------------------
    -- End screen detection
    --
    -- This uses Visible property events instead of polling.
    -----------------------------------------------------------------

    local function checkEndScreen()
        if restarting or not alive() then
            return
        end

        if not Win.Visible and not Lose.Visible then
            return
        end

        restarting = true

        if Win.Visible then
            print("[TD Farm] Win screen detected.")
        elseif Lose.Visible then
            print("[TD Farm] Lose screen detected.")
        end

        -----------------------------------------------------------------
        -- Stop macro
        -----------------------------------------------------------------

        TD.Stop()

        task.wait(2)

        -----------------------------------------------------------------
        -- Restart
        --
        -- The restarted game/script will handle startRound()
        -- again, so we don't manually call it here.
        -----------------------------------------------------------------

        if alive() then
            TD.Restart()
        end
    end

    -----------------------------------------------------------------
    -- Listen for Visible changes
    -----------------------------------------------------------------

    Win:GetPropertyChangedSignal("Visible"):Connect(checkEndScreen)

    Lose:GetPropertyChangedSignal("Visible"):Connect(checkEndScreen)

    -----------------------------------------------------------------
    -- Check once in case it was already visible
    -----------------------------------------------------------------

    checkEndScreen()
end)


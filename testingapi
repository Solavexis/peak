-- Lobby
---------------------------------------------------------------------

function M.Interact(towerName)
    local r = call("InteractItem", "InvokeServer", towerName)
    if r.Success then r.Data = r.Raw[1] end -- "Equipped" / "Unequipped" / ...
    return r
end

function M.SetEquipped(towerName, wanted)
    local d = M.GetData()
    if not d.Success then return d end
    local owned = d.Data.OwnedTowers
    if not contains(owned, towerName) then return makeError("Tower not owned.", "NOT_OWNED") end
    local isEquipped = contains(d.Data.TowersEquipped, towerName)
    if isEquipped == wanted then return success(wanted and "Equipped" or "Unequipped") end
    return M.Interact(towerName)
end
function M.Equip(n)   return M.SetEquipped(n, true) end
function M.Unequip(n) return M.SetEquipped(n, false) end

function M.GetMaps()
    local out = {}
    local f = RS:FindFirstChild("Maps")
    if f then for _, c in ipairs(f:GetChildren()) do table.insert(out, c.Name) end end
    return out
end

function M.GetMods()
    local out = {}
    local f = RS:FindFirstChild("Mods")
    if f then for _, c in ipairs(f:GetChildren()) do table.insert(out, c.Name) end end
    return out
end

-- mods = array of names {"Tix Loan","Haunted"} or dict {["Tix Loan"]=true}
function M.FinishSetup(map, mods, players)
    local e = requireLobby(); if e then return e end
    local maps = M.GetMaps()
    if not contains(maps, map) then return makeError("Unknown map '" .. tostring(map) .. "'.", "BAD_MAP") end

    local valid, dict = M.GetMods(), {}
    for k, v in pairs(mods or {}) do
        local name = (type(k) == "number") and v or k
        local on   = (type(k) == "number") and true or v
        if on then
            if not contains(valid, name) then return makeError("Unknown mod '" .. tostring(name) .. "'.", "BAD_MOD") end
            dict[name] = true
        end
    end
    return call("Elevator", "FireServer", "FinishSetup", dict, map, players or 1)
end

local ELEVATORS = { "Main", "Dream", "Hard", "Incident", "Korblox", "Undead", "Winter" }
function M.GetElevatorTypes() return table.clone(ELEVATORS) end

function M.JoinElevator(mode, opts)
    local e = requireLobby(); if e then return e end
    opts = opts or {}
    mode = mode or "Main"

    local folder = workspace:FindFirstChild("Elevators")
    local elevator = folder and folder:FindFirstChild("Elevator" .. mode)
    local entrance = elevator and elevator:FindFirstChild("Entrance")
    if not entrance then return makeError("Elevator '" .. mode .. "' not found.", "ELEVATOR_NOT_FOUND") end

    local hrp = getHRP()
    if not hrp then return makeError("No character.", "NO_CHARACTER") end

    if _firetouch then
        _firetouch(hrp, entrance, 0)
        task.wait(0.15)
        _firetouch(hrp, entrance, 1)
    else
        hrp.CFrame = entrance.CFrame + Vector3.new(0, 3, 0) -- fallback: physically step on it
    end

    if opts.Map then
        task.wait(opts.SetupDelay or 1)
        return M.FinishSetup(opts.Map, opts.Mods, opts.Players)
    end
    return success("Touched")
end


--[[
    Tower Defense Client API  (executor / client only)
    ---------------------------------------------------
    Host this file (GitHub raw, etc.) and load it with:

        getgenv().TD_LOADER_URL = "https://raw.githubusercontent.com/YOU/REPO/main/td_api.lua"
        local TD = loadstring(game:HttpGet(getgenv().TD_LOADER_URL))()

    Setting TD_LOADER_URL is what lets the API re-queue itself with queue_on_teleport.

    Every function returns {Success=bool, Data=..., Error=..., Code=...}
    unless noted (getters return the raw value or nil).

    Quick examples
    --------------
    TD.GetData()                                   -- lobby/game: player data table
    TD.SetEquipped("Slingshotter", true)           -- lobby
    TD.JoinElevator("Hard", {Map="Baseplate", Mods={"Tix Loan"}, Players=1})
    TD.Vote("Easy")                                -- game
    TD.StartRecording("run1")  ...place/upgrade manually...  TD.StopRecording(true)
    TD.Play("run1", {Mode="Timed"})                -- replay
    TD.SetAutoRun({                                -- full lobby -> game loop
        AutoJoin = {Elevator="Main", Map="Baseplate", Players=1},
        AutoPlay = {Macro="run1", Mode="Timed"},
    })
]]

local env = (getgenv and getgenv()) or _G

-- clean up a previous load
if env.TDAPI and env.TDAPI.Destroy then
    pcall(env.TDAPI.Destroy)
end


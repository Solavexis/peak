        Stats.WinStreak = 0
        print(string.format("[LOSS] Stage %d/%d | %d/%d wins (continuing...)", 
            currentStageIndex, #StageQueue, currentStageWins, stageConfig.WinsNeeded))
        
        saveStats()
    end


            spawnUnit(slotName)
        end
    end
end)

-- ============ FAST REJOIN ============
local function rejoin()
    print("[REJOIN] Rejoining game to continue farming...")
    saveStats()
    task.wait(0.5)
    game:GetService("TeleportService"):Teleport(game.PlaceId, LP)
end

-- ============ ADVANCE TO NEXT STAGE ============
local function advanceToNextStage()
    local completedStage = StageQueue[currentStageIndex]
    print(string.format("[STAGE] Completed %s Stage %d | %s | EXP: %.0f", 
        completedStage.Chapter, completedStage.Stage, getStarsDisplay(completedStage.Stars), currentStageEXP))
    
    sendWebhook(currentStageEXP, completedStage)
    Stats.CyclesCompleted = Stats.CyclesCompleted + 1
    
    currentStageIndex = currentStageIndex + 1
    currentStageWins = 0
    currentStageEXP = 0
    
    if currentStageIndex > #StageQueue then
        allStagesComplete = true
        print("========================================")
        print("   ✅ ALL STAGES COMPLETE! ✅")
        print("========================================")
        sendCompletionWebhook()
        
        Stats.CurrentStageIndex = 1
        Stats.CurrentStageWins = 0
        Stats.CurrentStageEXP = 0
        saveStats()
        rejoin()
        return
    end
    
    local nextStage = StageQueue[currentStageIndex]
    print(string.format("[NEXT] Moving to %s Stage %d | %s | Need %d wins", 
        nextStage.Chapter, nextStage.Stage, getStarsDisplay(nextStage.Stars), nextStage.WinsNeeded))
    
    saveStats()
    task.wait(0.5)
    startBattle()
end

-- ============ WIN OR LOSE HANDLER ============
ReplicatedStorage.Events.RemoteEvents.WinOrLose.OnClientEvent:Connect(function(didWin, exp, ...)
    if allStagesComplete then return end
    
    local stageConfig = getCurrentStageInfo()
    if not stageConfig then return end
    
    Stats.BattlesCompleted = Stats.BattlesCompleted + 1

    if didWin then
        Stats.Wins = Stats.Wins + 1
        Stats.WinStreak = Stats.WinStreak + 1
        Stats.BestWinStreak = math.max(Stats.BestWinStreak, Stats.WinStreak)
        
        local expGained = exp or 0
        Stats.TotalEXP = Stats.TotalEXP + expGained
        currentStageEXP = currentStageEXP + expGained
        table.insert(Stats.RecentEXP, expGained)
        
        if #Stats.RecentEXP > 50 then
            table.remove(Stats.RecentEXP, 1)
        end
        
        currentStageWins = currentStageWins + 1
        
        print(string.format("[WIN] +%.0f EXP | Stage %d/%d | %d/%d wins | Total: %.0f", 
            expGained, currentStageIndex, #StageQueue, currentStageWins, stageConfig.WinsNeeded, Stats.TotalEXP))

        if currentStageWins >= stageConfig.WinsNeeded then
            advanceToNextStage()
            return
        end
    else
        Stats.Losses = Stats.Losses + 1
        Stats.WinStreak = 0
        print(string.format("[LOSS] Stage %d/%d | %d/%d wins (continuing...)", 
            currentStageIndex, #StageQueue, currentStageWins, stageConfig.WinsNeeded))
        
        saveStats()
    end

    task.wait(0.5)
    startBattle()
end)


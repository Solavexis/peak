--[[
    Tower Defense UI (WindUI) - front-end for td_api.lua
    Host BOTH files, put their raw URLs below, then run:

        loadstring(game:HttpGet("https://raw.githubusercontent.com/YOU/REPO/main/td_ui.lua"))()

    This script loads the API itself, and re-queues ITSELF with queue_on_teleport,
    so the UI + API + auto-run chain comes back after every teleport.
]]

local API_URL = "https://raw.githubusercontent.com/Solavexis/peak/refs/heads/main/testingapi"
local UI_URL  = "https://raw.githubusercontent.com/Solavexis/peak/refs/heads/main/testingui"
local WIND_URL = "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"

local env = (getgenv and getgenv()) or _G
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

---------------------------------------------------------------------
-- Cleanup previous run
---------------------------------------------------------------------
if env.TD_UI then pcall(function() env.TD_UI:Destroy() end) end
local token = {}
env.TD_UI_TOKEN = token
local function alive() return env.TD_UI_TOKEN == token end

---------------------------------------------------------------------
-- Load API + WindUI
---------------------------------------------------------------------
env.TD_LOADER_URL = nil -- the UI handles re-queueing itself (avoids double loads)
local TD = loadstring(game:HttpGet(API_URL))()
local WindUI = loadstring(game:HttpGet(WIND_URL))()

local S = {
    elevator = "Main", map = nil, mods = {}, players = 1,
    tower = nil, towerId = nil, placeName = "Battler",
    vote = "Easy", macroName = "run1", macro = nil, mode = "Timed", retries = 30,
    autoSkip = false, autoUpgrade = false, queueUI = true,
    autoJoin = true, autoPlay = true,
}

local function notify(title, content, icon)
    pcall(function()
        WindUI:Notify({ Title = title, Content = tostring(content), Duration = 3, Icon = icon or "info" })
    end)
end

-- shows a toast for an API result
local function handle(r, okMsg)
    if r == nil then return end
    if r.Success then
        if okMsg then notify("Success", okMsg, "check") end
    else
        notify("Error", (r.Error or "unknown") .. " [" .. tostring(r.Code) .. "]", "x")
    end
    return r
end

local function orNone(list)
    if #list == 0 then return { "(none)" } end
    return list
end

local function cleanMods()
    local out = {}
    for _, m in ipairs(S.mods) do if m ~= "(none)" then table.insert(out, m) end end
    return out
end

local function queueUI()
    if S.queueUI then
        local r = TD.QueueOnTeleport(string.format("loadstring(game:HttpGet(%q))()", UI_URL))
        if not r.Success then notify("Queue failed", r.Error, "x") end
    end
end
queueUI()

---------------------------------------------------------------------
-- Window
---------------------------------------------------------------------
local Window = WindUI:CreateWindow({
    Title = "TD Macro Hub",
    Icon = "swords",
    Author = "TD API",
    Folder = "TDMacros",
    Size = UDim2.fromOffset(600, 470),
    Theme = "Dark",
    ToggleKey = Enum.KeyCode.RightShift,
})
env.TD_UI = Window

local function setDesc(el, text) pcall(function() el:SetDesc(text) end) end
local function refresh(dd, list) pcall(function() dd:Refresh(list) end) end

---------------------------------------------------------------------
-- STATUS TAB
---------------------------------------------------------------------
local Status = Window:Tab({ Title = "Status", Icon = "activity" })
local statusPara = Status:Paragraph({ Title = "Live status", Desc = "loading..." })
local dataPara = Status:Paragraph({ Title = "Player data", Desc = "Press 'Fetch data'." })

Status:Button({
    Title = "Fetch data",
    Desc = "GetData() - level, bricks, bux, towers",
    Callback = function()
        local r = handle(TD.GetData())
        if r and r.Success and type(r.Data) == "table" then
            local d = r.Data
            setDesc(dataPara, string.format(
                "Level %s (XP %s)\nBricks: %s   Bux: %s\nOwned towers: %d   Equipped: %s",
                tostring(d.Level), tostring(d.XP), tostring(d.Bricks), tostring(d.Bux),
                #(d.OwnedTowers or {}), table.concat(d.TowersEquipped or {}, ", ")
            ))
        end
    end,
})

task.spawn(function()
    while alive() do
        local place = TD.IsLobby() and "Lobby" or (TD.IsGame() and "In-game" or "Unknown place")
        local cash = TD.GetCash()
        setDesc(statusPara, string.format(
            "Place: %s (%d)\nCash: %s\nRecording: %s   Playing: %s",
            place, game.PlaceId, cash and ("$" .. cash) or "n/a",
            tostring(TD.IsRecording()), tostring(TD.IsPlaying())
        ))
        task.wait(0.5)
    end
end)

---------------------------------------------------------------------
-- LOBBY TAB
---------------------------------------------------------------------
local Lobby = Window:Tab({ Title = "Lobby", Icon = "door-open" })

Lobby:Section({ Title = "Towers" })
local towerDD
towerDD = Lobby:Dropdown({
    Title = "Owned tower",
    Values = { "(fetch first)" },
    Value = "(fetch first)",
    Callback = function(v) S.tower = v end,
})
Lobby:Button({
    Title = "Refresh owned towers",
    Callback = function()
        local r = handle(TD.GetData())
        if r and r.Success and r.Data.OwnedTowers then
            refresh(towerDD, r.Data.OwnedTowers)
            notify("Towers", #r.Data.OwnedTowers .. " owned", "check")
        end
    end,
})

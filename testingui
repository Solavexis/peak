---------------------------------------------------------------------
env.TD_LOADER_URL = nil -- this script re-queues itself; avoid loading the API twice
TD = loadstring(game:HttpGet(API_URL))()
if not alive() then return end

local okDecode, macroData = pcall(function() return HttpService:JSONDecode(MACRO_JSON) end)
if not okDecode or type(macroData) ~= "table" then
    warn("[Doomspire Farm] Embedded macro is corrupt: " .. tostring(macroData))
    return
end

-- write it where the API expects macros, so loadout fixing across teleports works
local saved = TD.SaveMacro(MACRO_NAME, macroData)
if not saved.Success then
    warn("[Doomspire Farm] Could not save macro: " .. tostring(saved.Error))
end


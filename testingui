-- GAME TAB
---------------------------------------------------------------------
local Game = Window:Tab({ Title = "Game", Icon = "gamepad-2" })

Game:Section({ Title = "Match control" })
Game:Dropdown({
    Title = "Difficulty",
    Values = { "Easy", "Normal", "Hard" },
    Value = "Easy",
    Callback = function(v) S.vote = v end,
})
Game:Button({ Title = "Vote", Callback = function() handle(TD.Vote(S.vote), "Voted " .. S.vote) end })
Game:Button({ Title = "Skip wave", Callback = function() handle(TD.Skip(), "Skipped") end })
Game:Button({ Title = "Pause / unpause", Callback = function() handle(TD.Pause()) end })
Game:Button({ Title = "Restart", Callback = function() handle(TD.Restart(), "Restart sent") end })
Game:Toggle({ Title = "Auto skip", Value = false, Callback = function(v) S.autoSkip = v end })
Game:Toggle({ Title = "Auto upgrade all my towers", Value = false, Callback = function(v) S.autoUpgrade = v end })

Game:Section({ Title = "Place tower" })
Game:Input({ Title = "Tower name", Value = "Battler", Callback = function(v) S.placeName = v end })
Game:Button({
    Title = "Place at my feet",
    Desc = "Raycasts down from your character",
    Callback = function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then notify("Error", "No character", "x") return end
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = { char }
        params.FilterType = Enum.RaycastFilterType.Exclude
        local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -30, 0), params)
        local pos = hit and hit.Position or hrp.Position
        local r = handle(TD.PlaceTower(S.placeName, CFrame.new(pos)))
        if r and r.Success then notify("Placed", "Tower #" .. r.Data.Name, "check") end
    end,
})

Game:Section({ Title = "My towers" })
local ownedTowerDD
ownedTowerDD = Game:Dropdown({
    Title = "Tower id",
    Values = { "(refresh)" },
    Value = "(refresh)",
    Callback = function(v) S.towerId = v end,
})
local towerInfo = Game:Paragraph({ Title = "Tower info", Desc = "Select a tower and press 'Inspect'." })
Game:Button({
    Title = "Refresh my towers",
    Callback = function()
        local list = {}
        for _, t in ipairs(TD.GetTowers(true)) do
            table.insert(list, t.Id)
        end
        refresh(ownedTowerDD, orNone(list))
        notify("Towers", #list .. " found", "check")
    end,
})
local function needId()
    if not S.towerId or S.towerId == "(refresh)" or S.towerId == "(none)" then
        notify("Pick a tower", "Refresh and select an id.", "x") return false
    end
    return true
end
Game:Button({
    Title = "Inspect",
    Callback = function()
        if not needId() then return end
        local r = handle(TD.GetTowerAttributes(S.towerId))
        if r and r.Success then
            local a = r.Data
            setDesc(towerInfo, string.format(
                "Name: %s\nLevel: %s\nOwner: %s\nSell price: %s\nNext upgrade: %s",
                tostring(a.Name), tostring(a.Level), tostring(a.Owner), tostring(a.SellPrice), tostring(a.UpgradeName)
            ))
        end
    end,
})
Game:Button({ Title = "Upgrade", Callback = function() if needId() then handle(TD.UpgradeTower(S.towerId), "Upgraded") end end })
Game:Button({ Title = "Use ability", Callback = function() if needId() then handle(TD.UseAbility(S.towerId), "Ability used") end end })

Game:Section({ Title = "Fake game message" })
Game:Button({ Title = "Show 'You need: $241 More.'", Callback = function() handle(TD.Notify("You need: $241 More.", Color3.new(1, 0, 0))) end })

task.spawn(function()
    while alive() do
        if TD.IsGame() then
            if S.autoSkip then TD.Skip() end
            if S.autoUpgrade then
                for _, t in ipairs(TD.GetTowers(true)) do
                    if not alive() or not S.autoUpgrade then break end
                    TD.UpgradeTower(t.Instance)
                end
            end
        end
        task.wait(1)
    end
end)


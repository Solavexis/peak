--//====================================================

function TowerAPI.SetTarget(towerID, targetType)
	local tower = TowerAPI._ResolveTower(towerID)

	if not tower then
		return makeError(
			"TOWER_NOT_FOUND",
			"Could not find tower: " .. tostring(towerID)
		)
	end

	if type(targetType) ~= "string" then
		return makeError(
			"INVALID_TARGET",
			"Target type must be a string."
		)
	end

	-- The actual target remote has not been provided yet.
	--
	-- This records the requested action so the API already
	-- understands target changes.
	--
	-- Replace this section when the game's real target
	-- remote is available.

	recordAction({
		Type = "SetTarget",

		Tower = TowerAPI._GetTowerID(tower),

		Target = targetType,
	})

	return makeError(
		"TARGET_REMOTE_MISSING",
		"SetTarget is defined, but the game's target remote has not been provided yet."
	)
end



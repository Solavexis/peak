---------------------------------------------------------------------
-- Lobby: wait for the API's loadout fix, then rejoin the elevator
---------------------------------------------------------------------
if TD.IsLobby() then
    task.spawn(function()
        local STATE_FILE = "TDMacros/_state.json"
        local start = os.clock()
        while alive() and os.clock() - start < 25 do
            local pending = false
            if isfile and readfile and isfile(STATE_FILE) then
                pcall(function()
                    pending = HttpService:JSONDecode(readfile(STATE_FILE)).PendingFix ~= nil
                end)
            end
            if not pending then break end
            task.wait(0.5)
        end

        if AUTO_JOIN and alive() then
            task.wait(2)
            local r = TD.JoinElevator(AUTO_JOIN.Elevator or "Main", {
                Map = AUTO_JOIN.Map, Mods = AUTO_JOIN.Mods, Players = AUTO_JOIN.Players,
            })
            if not r.Success then warn("[Doomspire Farm] Join failed: " .. tostring(r.Error)) end
        end
    end)
    print("[Doomspire Farm] Lobby: auto-join " .. (AUTO_JOIN and "on" or "off"))
    return
end

if not TD.IsGame() then return end

---------------------------------------------------------------------
-- Loading
---------------------------------------------------------------------
local function waitUntilFullyLoaded()
    if not alive() or not TD.IsGame() then return false end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    if not alive() then return false end
    if not char:WaitForChild("HumanoidRootPart", 15) then return false end

    local hum = char:WaitForChild("Humanoid", 15)
    if not hum then return false end
    while alive() and hum.Health <= 0 do task.wait(0.2) end
    if not alive() then return false end

    local Events = ReplicatedStorage:WaitForChild("Events", 30)
    if not Events then return false end
    local GameEvents = Events:WaitForChild("Game", 30)
    if not GameEvents then return false end
    if not GameEvents:WaitForChild("StartGame", 30) then return false end
    if not workspace:WaitForChild("Towers", 30) then return false end

    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 30)
    if not PlayerGui then return false end
    if not PlayerGui:WaitForChild("GameGUI", 30) then return false end

    task.wait(1)
    return alive()
end

local function startGameMode()
    if not alive() then return end
    if VOTE == "Start" then
        ReplicatedStorage:WaitForChild("Events"):WaitForChild("Game"):WaitForChild("StartGame"):FireServer()
        print("[Doomspire Farm] Fired StartGame remote.")
    else
        TD.Vote(VOTE)
        print("[Doomspire Farm] Voted: " .. tostring(VOTE))
    end
end

---------------------------------------------------------------------
-- Round
---------------------------------------------------------------------
local farming = false
local restarting = false

local function startRound()
    if farming or restarting or not alive() or not TD.IsGame() then return end
    farming = true

    if not waitUntilFullyLoaded() or not alive() or not TD.IsGame() then
        farming = false
        return
    end

    startGameMode()
    task.wait(1)
    if not alive() then farming = false return end

    local playDone = false
    local result = TD.Play(MACRO_NAME, {
        Mode = MODE,
        Retries = RETRIES,
        CheckMoney = CHECK_MONEY,
        RequireLoadout = REQUIRE_LOADOUT,
        RepairTowers = REPAIR,
        RepairOptions = REPAIR_OPTIONS,
        Delays = DELAYS,
        OnDone = function() playDone = true end,
    })

    if not result.Success then
        warn("[Doomspire Farm] Play failed: " .. tostring(result.Error) .. " [" .. tostring(result.Code) .. "]")
        TD.Notify("Auto-farm: " .. tostring(result.Error), Color3.new(1, 0, 0))
        farming = false
        return
    end

    while alive() and not playDone and TD.IsPlaying() do task.wait(0.5) end
    farming = false
end

---------------------------------------------------------------------
-- End screen detection + restart loop
---------------------------------------------------------------------
local Win, Lose
local lastWinVisible, lastLoseVisible = false, false

local function refreshEndScreen()
    Win, Lose = nil, nil
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local GameGUI = PlayerGui and PlayerGui:FindFirstChild("GameGUI")
    local EndScreen = GameGUI and GameGUI:FindFirstChild("EndScreen")
    if not EndScreen then return end
    Win = EndScreen:FindFirstChild("Win")
    Lose = EndScreen:FindFirstChild("Lose")
end

local function endScreenShown()
    refreshEndScreen()
    return (Win and Win.Visible) or (Lose and Lose.Visible) or false
end

local function waitForRestartComplete()
    local start = os.clock()
    while alive() and os.clock() - start < 30 do
        if not endScreenShown() then break end
        task.wait(0.25)
    end

    start = os.clock()
    while alive() and os.clock() - start < 15 do
        local folder = workspace:FindFirstChild("Towers")
        if not folder or #folder:GetChildren() == 0 then break end
        task.wait(0.25)
    end

    task.wait(2)
end

local function doRestart(reason)
    if restarting or not alive() then return end
    restarting = true
    print("[Doomspire Farm] Restart triggered by: " .. tostring(reason))

    pcall(TD.Stop)

    local t = os.clock()
    while farming and alive() and os.clock() - t < 5 do task.wait(0.1) end

    task.wait(2)
    if not alive() then restarting = false return end
    pcall(TD.Restart)

    waitForRestartComplete()

    lastWinVisible, lastLoseVisible = false, false
    restarting = false

    if alive() and TD.IsGame() then startRound() end
end

local lastCheck = 0
local function checkWinLoss()
    if not alive() or restarting then return end

    local now = os.clock()
    if now - lastCheck < 0.1 then return end
    lastCheck = now

    if not Win or not Win.Parent or not Lose or not Lose.Parent then refreshEndScreen() end
    if not Win or not Lose then return end

    local winVisible, loseVisible = Win.Visible, Lose.Visible

    if winVisible and not lastWinVisible then
        lastWinVisible, lastLoseVisible = winVisible, loseVisible
        print("[Doomspire Farm] Win detected.")
        task.spawn(doRestart, "WinScreen")
        return
    end

    if loseVisible and not lastLoseVisible then
        lastWinVisible, lastLoseVisible = winVisible, loseVisible
        print("[Doomspire Farm] Lose detected.")
        task.spawn(doRestart, "LoseScreen")
        return
    end

    lastWinVisible, lastLoseVisible = winVisible, loseVisible
end
connect(RunService.PreRender, checkWinLoss)

local function setupAwardWatcher()
    local Events = ReplicatedStorage:WaitForChild("Events", 30)
    if not Events then return end
    local GameEvents = Events:WaitForChild("Game", 30)
    if not GameEvents then return end
    local AwardEvent = GameEvents:WaitForChild("Award", 30)
    if not AwardEvent or not alive() then return end

    connect(AwardEvent.OnClientEvent, function(awardId, awardName)
        if restarting or not alive() then return end
        print("[Doomspire Farm] Award event - id=" .. tostring(awardId) .. ", name=" .. tostring(awardName))
        task.spawn(doRestart, "AwardEvent")
    end)
end

connect(Players.PlayerRemoving, function(player)
    if player == LocalPlayer then cleanup() end
end)

task.spawn(function()
    if not waitUntilFullyLoaded() then return end
    if not alive() or not TD.IsGame() then return end
    refreshEndScreen()
    setupAwardWatcher()
    startRound()
end)

print("[Doomspire Farm] Running macro '" .. MACRO_NAME .. "' (start: " .. tostring(VOTE) .. ", auto-replace: " .. tostring(REPAIR) .. ")")

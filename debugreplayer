local function button(parent, text, pos, size, cb)
    local b = make("TextButton", {
        Text = text, Position = pos, Size = size, BackgroundColor3 = C.btn, AutoButtonColor = true,
        TextColor3 = C.text, Font = Enum.Font.Code, TextSize = 12, BorderSizePixel = 0,

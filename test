local function startBattle()
    local stageConfig = getCurrentStageInfo()
    if not stageConfig then
        print("[BATTLE] No more stages to farm!")
        return
    end

    Stats.TotalExecutions = Stats.TotalExecutions + 1
    print(string.format("[BATTLE] Starting %s Stage %d | Normal | %s", 
        stageConfig.Chapter, stageConfig.Stage, getStarsDisplay(stageConfig.Stars)))
    
    pcall(function()
        ReplicatedStorage.Events.RemoteFunction.StartBattle:InvokeServer(
            stageConfig.Chapter,
            stageConfig.Stage,
            stageConfig.Difficulty,
            stageConfig.Stars,
            false,
            {},
            false,
            1
        )
    end)
end

local function spawnUnit(unitName, extraArgs)
    if extraArgs then
        pcall(function()
            ReplicatedStorage.Events.RemoteFunction.PlayerSpawn:InvokeServer(unitName, extraArgs)
        end)
    else
        pcall(function()
            ReplicatedStorage.Events.RemoteFunction.PlayerSpawn:InvokeServer(unitName)
        end)
    end
end


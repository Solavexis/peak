--//====================================================
--// CONFIG
--//====================================================

local Config = {
	Debug = true,

	-- If true, remotes will not actually be fired.
	DryRun = false,

	-- Default timeout for conditions.
	DefaultTimeout = 15,

	-- How often conditions are checked.
	ConditionInterval = 0.05,

	-- How long to wait for a newly placed tower
	-- to appear in workspace.Towers.
	TowerDetectionTimeout = 5,

	-- Automatically record successful API actions.
	AutoRecord = true,
}


--//====================================================
--// API TABLE
--//====================================================

local TowerAPI = {}


--//====================================================
--// INTERNAL STATE
--//====================================================

local State = {
	Recording = false,
	Replaying = false,
	Paused = false,

	CurrentAction = 0,
	CurrentReplay = nil,

	RecordingStarted = nil,

	NextTowerID = 1,

	Towers = {},

	TowerInstances = {},

	ReplayToken = 0,

	TeleportQueue = nil,

	LastError = nil,

	DialogueHistory = {},
}


--//====================================================
--// EVENTS
--//====================================================

TowerAPI.Events = {
	OnError = Instance.new("BindableEvent"),
	OnAction = Instance.new("BindableEvent"),

	OnReplayStart = Instance.new("BindableEvent"),
	OnReplayFinished = Instance.new("BindableEvent"),
	OnReplayStopped = Instance.new("BindableEvent"),

	OnTeleport = Instance.new("BindableEvent"),

	OnDialogue = Instance.new("BindableEvent"),
}


--//====================================================
--// HELPERS
--//====================================================

local function debugPrint(...)
	if not Config.Debug then
		return
	end

	print("[TowerAPI]", ...)
end


local function makeError(code, message, extra)
	local errorData = {
		Success = false,
		Code = code,
		Message = message,
		Time = os.time(),
	}

	if extra then
		for key, value in pairs(extra) do
			errorData[key] = value
		end
	end

	State.LastError = errorData

	TowerAPI.Events.OnError:Fire(errorData)

	warn(
		"[TowerAPI]",
		"[" .. tostring(code) .. "]",
		message
	)

	return errorData
end


local function success(data)
	if data == nil then
		return true
	end

	return data
end


local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end

	local result = {}

	for key, child in pairs(value) do
		result[key] = deepCopy(child)
	end

	return result
end


local function serializeCFrame(cf)
	return {
		cf:GetComponents()
	}
end


local function deserializeCFrame(data)
	if type(data) ~= "table" then
		return nil
	end

	if #data ~= 12 then
		return nil
	end

	return CFrame.new(table.unpack(data))
end


local function getTowersFolder()
	return workspace:FindFirstChild("Towers")
end


local function isTowerInstance(instance)
	return typeof(instance) == "Instance"
		and instance:IsDescendantOf(workspace)
end


--//====================================================
--// TOWER ID SYSTEM
--//====================================================

function TowerAPI._GetTowerID(tower)
	if not tower or not isTowerInstance(tower) then
		return nil
	end

	for id, instance in pairs(State.TowerInstances) do
		if instance == tower then
			return id
		end
	end

	-- If the actual workspace name is numeric,
	-- preserve it as the tower ID.
	local numericName = tonumber(tower.Name)

	if numericName then
		local id = tostring(numericName)

		State.TowerInstances[id] = tower
		State.Towers[id] = {
			ID = id,
			Instance = tower,
			Name = tower.Name,
		}

		return id
	end

	-- Otherwise generate a local ID.
	local id = tostring(State.NextTowerID)

	State.NextTowerID += 1

	State.TowerInstances[id] = tower

	State.Towers[id] = {
		ID = id,
		Instance = tower,
		Name = tower.Name,
	}

	return id
end


function TowerAPI._ResolveTower(towerID)
	if typeof(towerID) == "Instance" then
		if isTowerInstance(towerID) then
			return towerID
		end

		return nil
	end

	if towerID == nil then
		return nil
	end

	local id = tostring(towerID)

	-- Local mapping.
	local mapped = State.TowerInstances[id]

	if mapped and isTowerInstance(mapped) then
		return mapped
	end

	-- Direct workspace lookup.
	local towersFolder = getTowersFolder()

	if towersFolder then
		local direct = towersFolder:FindFirstChild(id)

		if direct then
			State.TowerInstances[id] = direct

			State.Towers[id] = {
				ID = id,
				Instance = direct,
				Name = direct.Name,
			}

			return direct
		end
	end

	return nil
end


function TowerAPI.GetTower(towerID)
	return TowerAPI._ResolveTower(towerID)
end


function TowerAPI.GetTowers()
	local towersFolder = getTowersFolder()

	if not towersFolder then
		return {}
	end

	local result = {}

	for _, tower in ipairs(towersFolder:GetChildren()) do
		local id = TowerAPI._GetTowerID(tower)

		table.insert(result, {
			ID = id,
			Instance = tower,
			Name = tower.Name,
		})
	end

	return result
end


function TowerAPI.RefreshTowers()
	local towersFolder = getTowersFolder()

	if not towersFolder then
		return {}
	end

	for _, tower in ipairs(towersFolder:GetChildren()) do
		TowerAPI._GetTowerID(tower)
	end

	return TowerAPI.GetTowers()
end



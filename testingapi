local afkConn
function M.SetAntiAFK(enabled)
    if afkConn then afkConn:Disconnect() afkConn = nil end
    if enabled then
        afkConn = LocalPlayer.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end
    return success(enabled)
end
function M.IsAntiAFKEnabled() return afkConn ~= nil end

---------------------------------------------------------------------
-- Anti-jumpscare
-- Jumpscare mods clone ReplicatedStorage.FX.Jumpscare into the PlayerGui;
-- this watches for it and deletes it the moment it appears.
---------------------------------------------------------------------
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local jumpscareConn

local function jumpscareName()
    local fx = RS:FindFirstChild("FX")
    local template = fx and fx:FindFirstChild("Jumpscare")
    return template and template.Name or "Jumpscare"
end

local function killJumpscare(child)
    if child.Name ~= jumpscareName() then return end
    child:Destroy()
    M.Notify("Game tried to jumpscare but failed: Script successfully deleted the Jumpscare UI", Color3.new(0, 1, 0))
end

function M.SetAntiJumpscare(enabled)
    if jumpscareConn then jumpscareConn:Disconnect() jumpscareConn = nil end
    if enabled then
        -- catch anything already present, then anything added from here on
        for _, child in ipairs(PlayerGui:GetChildren()) do killJumpscare(child) end
        jumpscareConn = PlayerGui.ChildAdded:Connect(killJumpscare)
    end
    return success(enabled)
end
function M.IsAntiJumpscareEnabled() return jumpscareConn ~= nil end

---------------------------------------------------------------------
-- Data / ownership
---------------------------------------------------------------------
local function contains(list, v)
    for _, x in ipairs(list or {}) do if x == v then return true end end
    return false
end

-- Owned/equipped towers are cached in memory AND on disk, so the in-game place
-- (where the GetData remote may not exist) can still verify ownership.
local OWNED_FILE = M.Folder .. "/_owned.json"
local ownedCache -- { Owned = {...}, Equipped = {...} }

local function cacheOwned(data)
    if type(data) ~= "table" or type(data.OwnedTowers) ~= "table" then return end
    ownedCache = { Owned = data.OwnedTowers, Equipped = data.TowersEquipped or {} }
    if writefile then
        pcall(function()
            if isfolder and not isfolder(M.Folder) then makefolder(M.Folder) end
            writefile(OWNED_FILE, HttpService:JSONEncode(ownedCache))
        end)
    end
end

function M.GetData()
    local r = call("GetData", "InvokeServer")
    if r.Success then cacheOwned(r.Data) end
    return r
end

-- success({Owned = {...}, Equipped = {...}}); forceRefresh re-reads from the server if possible
function M.GetOwnedTowers(forceRefresh)
    if ownedCache and not forceRefresh then return success(ownedCache) end

    local remotes = RS:FindFirstChild("Remotes")
    if remotes and remotes:FindFirstChild("GetData") then
        M.GetData() -- updates ownedCache on success
        if ownedCache then return success(ownedCache) end
    end

    if isfile and readfile and isfile(OWNED_FILE) then
        local ok, d = pcall(function() return HttpService:JSONDecode(readfile(OWNED_FILE)) end)
        if ok and type(d) == "table" and type(d.Owned) == "table" then
            ownedCache = d
            return success(d)
        end
    end
    return makeError("Couldn't verify owned towers. Open the lobby once (or run GetData) first.", "OWNERSHIP_UNKNOWN")
end

function M.IsOwned(towerName)
    local r = M.GetOwnedTowers()
    return r.Success and contains(r.Data.Owned, towerName) or false
end


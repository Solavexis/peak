-- Recursively WaitForChild with a 30s total timeout
local function waitForPath(parent, names, totalTimeout)
    totalTimeout = totalTimeout or 30
    local deadline = os.clock() + totalTimeout
    local current = parent
    for _, name in ipairs(names) do
        if not current then return nil end
        local remaining = deadline - os.clock()
        if remaining <= 0 then return nil end
        current = current:WaitForChild(name, remaining)
    end
    return current
end


        if folder then
            local tower = folder:FindFirstChild(tostring(index))
            if tower then
                return API.Game.UseAbility(tower, abilityArg)
            end
        end
        return nil
    end

    function API.Game.PauseGame()
        local remote = getRemote({"Events", "Game", "PauseGame"})
        if remote then
            remote:FireServer()
            return true
        end
        return false
    end

    function API.Game.Restart()
        local remote = getRemote({"Events", "Game", "Restart"})
        if remote then
            remote:FireServer()
            return true
        end
        return false
    end

    --- Simulate an in-game message via firesignal
    function API.Game.SimulateMessage(text, color)
        local remote = getRemote({"Events", "Other", "Message"})
        if remote and remote.OnClientEvent then
            _firesignal(remote.OnClientEvent, text, color or Color3.new(1, 0, 0))
        end
    end

    --- Get a tower Instance by its index
    function API.Game.GetTower(index)
        local folder = WS:FindFirstChild("Towers")
        if folder then
            return folder:FindFirstChild(tostring(index))
        end
        return nil
    end

    function API.Game.GetAllTowers()
        return API.Utils.GetTowerList()
    end

    function API.Game.GetTowerCount()
        local folder = WS:FindFirstChild("Towers")
        return folder and #folder:GetChildren() or 0
    end

    -- ═══════════════════════════════════════════════════════════
    --  MACRO SYSTEM
    -- ═══════════════════════════════════════════════════════════
    API.Macro = {}

    local macro = {
        recording   = false,
        playing     = false,
        actions     = {},
        startTime   = 0,
        saved       = {},
        oldNamecall = nil,
        hooked      = false,
    }

    ---- Control ----

    function API.Macro.StartRecording()
        macro.recording = true
        macro.actions   = {}
        macro.startTime = tick()
    end

    function API.Macro.StopRecording()
        macro.recording = false
        return macro.actions
    end

    function API.Macro.IsRecording()
        return macro.recording
    end

    function API.Macro.IsPlaying()
        return macro.playing
    end

    function API.Macro.GetActions()
        return macro.actions
    end

    function API.Macro.Clear()
        macro.actions = {}
    end

    ---- Internal: record one action ----

    local function record(actionType, args)
        if not macro.recording then return end
        macro.actions[#macro.actions + 1] = {
            type = actionType,
            args = args,
            time = tick() - macro.startTime,
        }
    end

    ---- Manual action insertion ----

    function API.Macro.AddAction(actionType, args, delayAfter)
        local lastTime = #macro.actions > 0 and macro.actions[#macro.actions].time or 0
        macro.actions[#macro.actions + 1] = {
            type = actionType,
            args = args,
            time = lastTime + (delayAfter or 0),
        }
    end

    ---- Recordable wrappers (Lobby) ----

    function API.Macro.RecordInteractItem(itemName)
        record("InteractItem", { itemName = itemName })
        return API.Lobby.InteractItem(itemName)
    end

    function API.Macro.RecordJoinElevator(modifiers, mapName, playerCount)
        record("JoinElevator", { modifiers = modifiers, mapName = mapName, playerCount = playerCount })
        return API.Lobby.JoinElevator(modifiers, mapName, playerCount)
    end

    ---- Recordable wrappers (Game) ----

    function API.Macro.RecordVote(difficulty)
        record("Vote", { difficulty = difficulty })
        return API.Game.Vote(difficulty)
    end

    function API.Macro.RecordSkip()
        record("Skip", {})
        return API.Game.Skip()
    end

    function API.Macro.RecordPlaceTower(towerName, cframe)
        record("PlaceTower", { towerName = towerName, cframe = cframeToTable(cframe) })
        return API.Game.PlaceTower(towerName, cframe)
    end

    function API.Macro.RecordUpgradeTower(towerIndex, cframe)
        record("UpgradeTower", { towerIndex = towerIndex, cframe = cframeToTable(cframe) })
        return API.Game.UpgradeTowerByIndex(towerIndex, cframe)
    end

    function API.Macro.RecordUseAbility(towerIndex, abilityArg)
        record("UseAbility", { towerIndex = towerIndex, abilityArg = abilityArg })
        return API.Game.UseAbilityByIndex(towerIndex, abilityArg)
    end

    function API.Macro.RecordPauseGame()
        record("PauseGame", {})
        return API.Game.PauseGame()
    end

    function API.Macro.RecordRestart()
        record("Restart", {})
        return API.Game.Restart()
    end

    ---- Replay ----

    function API.Macro.Replay(opts)
        --[[
            opts = {
                onStep     = function(stepIndex, action, totalSteps) end,
                onComplete = function() end,
                speed      = 1,    -- 1 = normal, 2 = 2×, 0.5 = half
                loop       = false, -- repeat after finish
            }
        ]]
        if macro.playing then return false end
        if #macro.actions == 0 then return false end

        local o = type(opts) == "table" and opts or {}
        macro.playing = true

        local speed      = o.speed or 1
        local loop       = o.loop or false
        local onStep     = o.onStep
        local onComplete = o.onComplete

        local function runOnce()
            local start = tick()
            for i, action in ipairs(macro.actions) do
                if not macro.playing then return false end

                -- Wait until scheduled time (adjusted by speed)
                local target = start + (action.time / speed)
                local now    = tick()
                if target > now then
                    task.wait(target - now)
                end

                -- Execute the action
                local a = action.args
                local ok, err = pcall(function()
                    if action.type == "Vote" then
                        API.Game.Vote(a.difficulty)
                    elseif action.type == "Skip" then
                        API.Game.Skip()
                    elseif action.type == "PlaceTower" then
                        API.Game.PlaceTower(a.towerName, tableToCFrame(a.cframe))
                    elseif action.type == "UpgradeTower" then
                        API.Game.UpgradeTowerByIndex(a.towerIndex, tableToCFrame(a.cframe))
                    elseif action.type == "UseAbility" then
                        API.Game.UseAbilityByIndex(a.towerIndex, a.abilityArg)
                    elseif action.type == "PauseGame" then
                        API.Game.PauseGame()
                    elseif action.type == "Restart" then
                        API.Game.Restart()
                    elseif action.type == "InteractItem" then
                        API.Lobby.InteractItem(a.itemName)
                    elseif action.type == "JoinElevator" then
                        API.Lobby.JoinElevator(a.modifiers, a.mapName, a.playerCount)
                    end
                end)

                if not ok then
                    warn("[TD-API] Replay action #" .. i .. " failed: " .. tostring(err))
                end

                if onStep then onStep(i, action, #macro.actions) end
            end
            return true
        end

        spawn(function()
            repeat
                runOnce()
                if loop and macro.playing then
                    task.wait(1)
                end
            until not loop or not macro.playing

            macro.playing = false
            if onComplete then onComplete() end
        end)

        return true
    end

    function API.Macro.StopReplay()
        macro.playing = false
    end

    ---- Save / Load / Delete / List ----

    function API.Macro.Save(name)
        macro.saved[name] = {
            actions    = macro.actions,
            timestamp  = os.time(),
            actionCount = #macro.actions,
        }
        return true
    end

    function API.Macro.Load(name)
        local m = macro.saved[name]
        if m then
            macro.actions = m.actions
            return true
        end
        return false
    end

    function API.Macro.Delete(name)
        macro.saved[name] = nil
    end

    function API.Macro.ListSaved()
        local out = {}
        for name, data in pairs(macro.saved) do
            out[#out + 1] = {
                name       = name,
                actionCount = data.actionCount or #data.actions,
                timestamp  = data.timestamp,
            }
        end
        table.sort(out, function(a, b) return a.timestamp > b.timestamp end)
        return out
    end

    ---- Export / Import (JSON, CFrame-safe) ----

    function API.Macro.Export(name)
        local m = name and macro.saved[name] and macro.saved[name].actions or macro.actions
        local ok, json = pcall(function()
            return HttpService:JSONEncode(m)
        end)
        return ok and json or nil
    end

    function API.Macro.Import(jsonString)
        local ok, data = pcall(function()
            return HttpService:JSONDecode(jsonString)
        end)
        if ok and type(data) == "table" then
            macro.actions = data
            return true
        end
        return false
    end

    ---- Auto-hook recording (hooks __namecall on remotes) ----

    function API.Macro.InstallHooks()
        if macro.hooked then return false end
        if not _hookmetamethod or not _getnamecallmethod then
            warn("[TD-API] Cannot install hooks: hookmetamethod/getnamecallmethod not available")
            return false
        end

        macro.oldNamecall = _hookmetamethod(game, "__namecall", _newcclosure(function(self, ...)
            local method = _getnamecallmethod()

            if macro.recording and (method == "FireServer" or method == "InvokeServer") then
                local args = { ... }
                local name = self.Name

                -- Lobby remotes
                if name == "InteractItem" and method == "InvokeServer" then
                    record("InteractItem", { itemName = args[1] })

                elseif name == "Elevator" and method == "FireServer" then
                    -- args: "FinishSetup", modifiers, mapName, playerCount
                    record("JoinElevator", {
                        modifiers    = args[2],
                        mapName      = args[3],
                        playerCount  = args[4],
                    })

                -- Game remotes
                elseif name == "Vote" and method == "FireServer" then
                    record("Vote", { difficulty = args[1] })

                elseif name == "Skip" and method == "FireServer" then
                    record("Skip", {})

                elseif name == "PlaceTower" and method == "InvokeServer" then
                    if type(args[1]) == "string" then
                        -- New tower placement
                        record("PlaceTower", {
                            towerName = args[1],
                            cframe    = cframeToTable(args[2]),
                        })
                    elseif typeof(args[1]) == "Instance" then
                        -- Upgrade existing tower
                        record("UpgradeTower", {
                            towerIndex = args[1].Name,
                            cframe     = cframeToTable(args[2]),
                        })
                    end

                elseif name == "Ability" and method == "InvokeServer" then
                    local idx = typeof(args[1]) == "Instance" and args[1].Name or tostring(args[1])
                    record("UseAbility", { towerIndex = idx, abilityArg = args[2] })

                elseif name == "PauseGame" and method == "FireServer" then
                    record("PauseGame", {})

                elseif name == "Restart" and method == "FireServer" then
                    record("Restart", {})
                end
            end

            return macro.oldNamecall(self, ...)
        end))

        macro.hooked = true
        return true
    end

    function API.Macro.UninstallHooks()
        if not macro.hooked or not macro.oldNamecall then return false end
        _hookmetamethod(game, "__namecall", macro.oldNamecall)
        macro.oldNamecall = nil
        macro.hooked      = false
        return true
    end


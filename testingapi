--[[
    Tower Defense API — Client-Side
    Usage:
        local API = loadstring(game:HttpGet("YOUR_RAW_URL"))()
        -- or
        local API = loadstring(yourSource)()

    Features:
        • Game detection by PlaceId
        • Lobby & In-Game wrappers
        • Macro recorder / replayer with hooks
        • queue_on_teleport persistence
        • Uses exploit env: firesignal, firetouchinterest,
          hookmetamethod, getnamecallmethod, newcclosure
]]

return (function()
    local API = {}

    -- ═══════════════════════════════════════════════════════════
    --  CONSTANTS
    -- ═══════════════════════════════════════════════════════════
    local PLACE_LOBBY  = 15549445942
    local PLACE_INGAME = 15549929783

    local API_URL = "https://raw.githubusercontent.com/Solavexis/peak/refs/heads/main/testingapi"

    local ELEVATOR_MAP = {
        Normal   = "ElevatorMain",
        Dream    = "ElevatorDream",
        Hard     = "ElevatorHard",
        Incident = "ElevatorIncident",
        Korblox  = "ElevatorKorblox",
        Undead   = "ElevatorUndead",
        Winter   = "ElevatorWinter",
    }

    API.Version    = "1.0.0"
    API.PlaceIds   = { Lobby = PLACE_LOBBY, InGame = PLACE_INGAME }
    API.ElevatorTypes = ELEVATOR_MAP

    -- ═══════════════════════════════════════════════════════════
    --  SERVICES
    -- ═══════════════════════════════════════════════════════════
    local RS          = game:GetService("ReplicatedStorage")
    local WS          = game:GetService("Workspace")
    local Players     = game:GetService("Players")
    local HttpService = game:GetService("HttpService")
    local LocalPlayer = Players.LocalPlayer

    -- ═══════════════════════════════════════════════════════════
    --  EXPLOIT ENVIRONMENT (graceful fallbacks)
    -- ═══════════════════════════════════════════════════════════
    local _queue_on_teleport = queue_on_teleport or function() warn("[TD-API] queue_on_teleport not available") end
    local _firesignal        = firesignal        or function() warn("[TD-API] firesignal not available") end
    local _firetouchinterest = firetouchinterest  or function() warn("[TD-API] firetouchinterest not available") end
    local _hookmetamethod    = hookmetamethod     or nil
    local _getnamecallmethod = getnamecallmethod  or nil
    local _newcclosure       = newcclosure        or function(f) return f end

    -- ═══════════════════════════════════════════════════════════
    --  GAME STATE
    -- ═══════════════════════════════════════════════════════════
    API.PlaceId     = game.PlaceId
    API.IsLobby     = game.PlaceId == PLACE_LOBBY
    API.IsInGame    = game.PlaceId == PLACE_INGAME
    API.IsSupported = API.IsLobby or API.IsInGame

    -- ═══════════════════════════════════════════════════════════
    --  INTERNAL HELPERS
    -- ═══════════════════════════════════════════════════════════
    local function getRemote(path)
        local obj = RS
        for _, name in ipairs(path) do
            obj = obj:FindFirstChild(name)
            if not obj then return nil end
        end
        return obj
    end

    local function cframeToTable(cf)
        if typeof(cf) ~= "CFrame" then return {} end
        return { cf:GetComponents() }
    end

    local function tableToCFrame(t)
        if type(t) ~= "table" or #t == 0 then return CFrame.new() end
        return CFrame.new(unpack(t))
    end

    local function getHRP()
        local char = LocalPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    -- ═══════════════════════════════════════════════════════════
    --  PRINT INFO
    -- ═══════════════════════════════════════════════════════════
    function API.PrintInfo()
        print("─────────────────────────────────────")
        print("  Tower Defense API v" .. API.Version)
        print("  PlaceId:    " .. API.PlaceId)
        print("  IsLobby:    " .. tostring(API.IsLobby))
        print("  IsInGame:   " .. tostring(API.IsInGame))
        print("  Supported:  " .. tostring(API.IsSupported))
        print("─────────────────────────────────────")
    end

    -- ═══════════════════════════════════════════════════════════
B════════════════════════════════════════════════════════0═
   D═════════════════════════════════════════════════════════
    API.Utils = {}

    function API.Utils.FireSignalDignal, ...)
        _firesignal(signal, ...)
    end

    function API.Utils.FireTouchInterest(part, touchPartB flag)
        _firetouchinterest(part, touchPartB flag or 0)
    end

    function API.Utils.GetMaps()
        local folder = RS:FindFirstChild("Maps")
        if not folder then return {} end
        local out = {}
        for _, v in ipairs(folder:GetChildren()) do
            out[#out + 1] = v.Name
        end
        return out
    end

    function API.Utils.GetModifiers()
        local folder = RS:FindFirstChild("Mods")
        if not folder then return {} end
        local out = {}
        for _, v in ipairs(folder:GetChildren()) do
            out[#out + 1] = v.Name
        end
        return out
    end

    function API.Utils.GetTowerList()
        local folder = WS:FindFirstChild("Towers")
        if not folder then return {} end
        local out = {}
        for _, v in ipairs(folder:GetChildren()) do
            out[v.Name] = v
        end
        return out
    end

    function API.Utils.CFrameToTable(cf)
        return cframeToTable(cf)
    end

    function API.Utils.TableToCFrame(t)
        return tableToCFrame(t)
    end

    -- ═══════════════════════════════════════════════════════════
    --  LOBBY MODULE
    -- ═══════════════════════════════════════════════════════════
    API.Lobby = {}

    --- Fetch raw player data from the server
    function API.Lobby.GetData()
        local remote = getRemote({"Remotes", "GetData"})
        if remote then
            return remote:InvokeServer()
        end
        return nil
    end

    --- Get owned towers list
    function API.Lobby.GetOwnedTowers()
        local raw = API.Lobby.GetData()
        if type(raw) ~= "table" then return {} end
        local data = raw.OwnedTowers and raw or (raw[1] and raw[1].OwnedTowers and raw[1])
        return data and data.OwnedTowers or {}
    end

    --- Interact with an item (equip/unequip towers)
    function API.Lobby.InteractItem(itemName)
        local remote = getRemote({"Remotes", "InteractItem"})
        if remote then
            return table.pack(remote:InvokeServer(itemName))
        end
        return {}
    end

    function API.Lobby.EquipTower(towerName)
        return API.Lobby.InteractItem(towerName)
    end

    function API.Lobby.UnequipTower(towerName)
        return API.Lobby.InteractItem(towerName)
    end

    --- Walk into an elevator by type (uses firetouchinterest)
    function API.Lobby.EnterElevator(elevatorType)
        local elevators = WS:FindFirstChild("Elevators")
        if not elevators then return false end

        local eName    = ELEVATOR_MAP[elevatorType] or elevatorType
        local elevator = elevators:FindFirstChild(eName)
        if not elevator then return false end

        local entrance = elevator:FindFirstChild("Entrance")
        if not entrance then return false end
        if not entrance:FindFirstChild("TouchInterest") then return false end

        local hrp = getHRP()
        if not hrp then return false end

        _firetouchinterest(hrp, entrance, 0)
        task.wait(0.15)
        _firetouchinterest(hrp, entrance, 1)
        return true
    end

    --- Fire the Elevator remote to set up & start
    function API.Lobby.JoinElevator(modifiers, mapName, playerCount)
        local remote = getRemote({"Remotes", "Elevator"})
        if remote then
            remote:FireServer("FinishSetup", modifiers or {}, mapName or "Baseplate", playerCount or 1)
            return true
        end
        return false
    end

    --- Simulate a lobby message via firesignal
    function API.Lobby.SimulateMessage(text, color, sound)
        local remote = getRemote({"Remotes", "Message"})
        if remote and remote.OnClientEvent then
            _firesignal(remote.OnClientEvent, text, color or Color3.new(1, 1, 1), sound or "")
        end
    end

    function API.Lobby.GetMaps()
        return API.Utils.GetMaps()
    end

    function API.Lobby.GetModifiers()
        return API.Utils.GetModifiers()
    end


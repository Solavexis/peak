--==================================================
-- TOWER IDS
--==================================================

function TowerAPI._GetTowerID(tower)
    if not tower then
        return nil
    end

    for id, instance in pairs(State.TowerInstances) do
        if instance == tower then
            return id
        end
    end

    -- If this is a newly discovered tower, assign a permanent
    -- placement-order ID.
    local id = State.NextTowerID

    State.NextTowerID += 1

    State.TowerInstances[id] = tower
    State.Towers[id] = {
        Instance = tower,
        ID = id,
        Attributes = getTowerAttributes(tower),
    }

    -- New towers normally start at First.
    State.TowerTargets[id] = 1

    return id
end

function TowerAPI._ResolveTower(towerID)
    if typeof(towerID) == "Instance" then
        if isTowerInstance(towerID) then
            return towerID
        end

        return nil
    end

    local numericID = tonumber(towerID)

    if not numericID then
        return nil
    end

    local cached = State.TowerInstances[numericID]

    if cached and cached.Parent then
        return cached
    end

    local folder = getTowersFolder()

    if not folder then
        return nil
    end

    -- The game itself uses "1", "2", "3", etc.
    local tower = folder:FindFirstChild(tostring(numericID))

    if tower and isTowerInstance(tower) then
        State.TowerInstances[numericID] = tower

        if not State.Towers[numericID] then
            State.Towers[numericID] = {
                Instance = tower,
                ID = numericID,
                Attributes = getTowerAttributes(tower),
            }
        end

        if not State.TowerTargets[numericID] then
            State.TowerTargets[numericID] = 1
        end

        return tower
    end

    return nil
end

function TowerAPI.GetTower(towerID)
    return TowerAPI._ResolveTower(towerID)
end

function TowerAPI.GetTowers()
    local result = {}

    local folder = getTowersFolder()

    if not folder then
        return result
    end

    for _, tower in ipairs(folder:GetChildren()) do
        if isTowerInstance(tower) then
            local id = TowerAPI._GetTowerID(tower)

            result[#result + 1] = {
                ID = id,
                Instance = tower,
                Attributes = getTowerAttributes(tower),
                Target = TowerAPI.GetTarget(id),
            }
        end
    end

    table.sort(result, function(a, b)
        return a.ID < b.ID
    end)

    return result
end

function TowerAPI.RefreshTowers()
    local folder = getTowersFolder()

    if not folder then
        return makeError(
            "workspace.Towers does not exist.",
            "TOWERS_FOLDER_MISSING"
        )
    end

    local seen = {}

    for _, tower in ipairs(folder:GetChildren()) do
        if isTowerInstance(tower) then
            local id = TowerAPI._GetTowerID(tower)

            seen[id] = true

            State.Towers[id] = {
                Instance = tower,
                ID = id,
                Attributes = getTowerAttributes(tower),
            }

            if not State.TowerTargets[id] then
                State.TowerTargets[id] = 1
            end
        end
    end

    -- Remove references to towers that no longer exist.
    for id, instance in pairs(State.TowerInstances) do
        if not seen[id] and (not instance or not instance.Parent) then
            State.TowerInstances[id] = nil
            State.Towers[id] = nil
            State.TowerTargets[id] = nil
        end
    end

    return success(TowerAPI.GetTowers())
end


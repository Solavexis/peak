--==================================================
-- ACTION RECORDING
--==================================================

local function recordAction(action)
    if not Config.AutoRecord or not State.Recording then
        return
    end

    State.CurrentAction += 1

    action.Index = State.CurrentAction
    action.Time = os.clock() - (State.RecordingStarted or os.clock())

    table.insert(State.CurrentReplay.Actions, action)

    Events.OnAction:Fire(action)
end

function TowerAPI.StartRecording()
    if State.Recording then
        return makeError(
            "Already recording.",
            "ALREADY_RECORDING"
        )
    end

    State.Recording = true
    State.RecordingStarted = os.clock()
    State.CurrentAction = 0

    State.CurrentReplay = {
        Version = 1,
        Created = os.time(),
        Actions = {},
    }

    return success(State.CurrentReplay)
end

function TowerAPI.StopRecording()
    if not State.Recording then
        return makeError(
            "Not currently recording.",
            "NOT_RECORDING"
        )
    end

    State.Recording = false

    return success(deepCopy(State.CurrentReplay))
end

function TowerAPI.GetRecording()
    return deepCopy(State.CurrentReplay)
end

--==================================================
-- WAIT FOR TOWER
--==================================================

local function waitForNewTower(previousTowers, timeout)
    local folder = getTowersFolder()

    if not folder then
        return nil
    end

    local start = os.clock()

    while os.clock() - start < timeout do
        for _, tower in ipairs(folder:GetChildren()) do
            if isTowerInstance(tower) and not previousTowers[tower] then
                return tower
            end
        end

        task.wait(Config.ConditionInterval)
    end

    return nil
end

--==================================================
-- PLACE
--==================================================

function TowerAPI.Place(towerName, cframe)
    if type(towerName) ~= "string" then
        return makeError(
            "towerName must be a string.",
            "INVALID_TOWER_NAME"
        )
    end

    if typeof(cframe) ~= "CFrame" then
        return makeError(
            "cframe must be a CFrame.",
            "INVALID_CFRAME"
        )
    end

    local folder = getTowersFolder()

    local before = {}

    if folder then
        for _, tower in ipairs(folder:GetChildren()) do
            before[tower] = true
        end
    end

    if Config.DryRun then
        debugPrint("DRY RUN Place", towerName, cframe)

        recordAction({
            Type = "Place",
            TowerName = towerName,
            CFrame = serializeCFrame(cframe),
        })

        return success({
            DryRun = true,
        })
    end

    local ok, result = pcall(function()
        return PlaceTowerRemote:InvokeServer(
            towerName,
            cframe
        )
    end)

    if not ok then
        return makeError(
            result,
            "PLACE_FAILED"
        )
    end

    local tower = waitForNewTower(
        before,
        Config.TowerDetectionTimeout
    )

    if tower then
        local id = TowerAPI._GetTowerID(tower)

        State.Towers[id] = {
            Instance = tower,
            ID = id,
            Attributes = getTowerAttributes(tower),
        }

        State.TowerTargets[id] = 1

        Events.OnTowerAdded:Fire(id, tower)
    end

    recordAction({
        Type = "Place",
        TowerName = towerName,
        CFrame = serializeCFrame(cframe),
        Tower = tower and TowerAPI._GetTowerID(tower) or nil,
    })

    return success({
        Result = result,
        Tower = tower,
        ID = tower and TowerAPI._GetTowerID(tower) or nil,
    })
end

--==================================================
-- UPGRADE
--==================================================

function TowerAPI.Upgrade(towerID, cframe)
    local tower = TowerAPI._ResolveTower(towerID)

    if not tower then
        return makeError(
            "Tower does not exist.",
            "TOWER_NOT_FOUND"
        )
    end

    if typeof(cframe) ~= "CFrame" then
        return makeError(
            "cframe must be a CFrame.",
            "INVALID_CFRAME"
        )
    end

    local id = TowerAPI._GetTowerID(tower)

    if Config.DryRun then
        recordAction({
            Type = "Upgrade",
            Tower = id,
            CFrame = serializeCFrame(cframe),
        })

        return success({
            DryRun = true,
        })
    end

    local ok, result = pcall(function()
        return PlaceTowerRemote:InvokeServer(
            tower,
            cframe,
            true
        )
    end)

    if not ok then
        return makeError(
            result,
            "UPGRADE_FAILED"
        )
    end

    task.wait()

    State.Towers[id] = {
        Instance = tower,
        ID = id,
        Attributes = getTowerAttributes(tower),
    }

    recordAction({
        Type = "Upgrade",
        Tower = id,
        CFrame = serializeCFrame(cframe),
    })

    return success({
        Result = result,
        ID = id,
        Attributes = getTowerAttributes(tower),
    })
end

--==================================================
-- SELL
--==================================================

function TowerAPI.Sell(towerID)
    local tower = TowerAPI._ResolveTower(towerID)

    if not tower then
        return makeError(
            "Tower does not exist.",
            "TOWER_NOT_FOUND"
        )
    end

    local id = TowerAPI._GetTowerID(tower)

    if Config.DryRun then
        recordAction({
            Type = "Sell",
            Tower = id,
        })

        return success({
            DryRun = true,
        })
    end

    local ok, result = pcall(function()
        return SellTowerRemote:InvokeServer(tower)
    end)

    if not ok then
        return makeError(
            result,
            "SELL_FAILED"
        )
    end

    recordAction({
        Type = "Sell",
        Tower = id,
    })

    -- IMPORTANT:
    -- Do NOT decrement NextTowerID.
    --
    -- Selling tower 3 means the next new tower remains 4.
    State.TowerInstances[id] = nil
    State.Towers[id] = nil
    State.TowerTargets[id] = nil

    Events.OnTowerRemoved:Fire(id, tower)

    return success({
        Result = result,
        ID = id,
    })
end

--==================================================
-- TARGETING
--==================================================

function TowerAPI.GetTargetOrder()
    return deepCopy(Config.TargetOrder)
end

function TowerAPI.GetTarget(towerID)
    local tower = TowerAPI._ResolveTower(towerID)

    if not tower then
        return nil
    end

    local id = TowerAPI._GetTowerID(tower)
    local index = State.TowerTargets[id] or 1

    return Config.TargetOrder[index]
end

function TowerAPI.CycleTarget(towerID)
    local tower = TowerAPI._ResolveTower(towerID)

    if not tower then
        return makeError(
            "Tower does not exist.",
            "TOWER_NOT_FOUND"
        )
    end

    local id = TowerAPI._GetTowerID(tower)

    local currentIndex = State.TowerTargets[id] or 1

    local newIndex = currentIndex + 1

    if newIndex > #Config.TargetOrder then
        newIndex = 1
    end

    if Config.DryRun then
        State.TowerTargets[id] = newIndex

        recordAction({
            Type = "CycleTarget",
            Tower = id,
            Target = Config.TargetOrder[newIndex],
        })

        return success({
            Target = Config.TargetOrder[newIndex],
        })
    end

    local ok, result = pcall(function()
        return ChangeTargetRemote:InvokeServer(tower)
    end)

    if not ok then
        return makeError(
            result,
            "CHANGE_TARGET_FAILED"
        )
    end

    State.TowerTargets[id] = newIndex

    local target = Config.TargetOrder[newIndex]

    recordAction({
        Type = "CycleTarget",
        Tower = id,
        Target = target,
    })

    return success({
        Result = result,
        Target = target,
        ID = id,
    })
end

function TowerAPI.SetTarget(towerID, targetType)
    if type(targetType) ~= "string" then
        return makeError(
            "targetType must be a string.",
            "INVALID_TARGET"
        )
    end

    local desiredIndex

    for index, name in ipairs(Config.TargetOrder) do
        if string.lower(name) == string.lower(targetType) then
            desiredIndex = index
            break
        end
    end

    if not desiredIndex then
        return makeError(
            "Invalid target: " .. targetType,
            "INVALID_TARGET"
        )
    end

    local tower = TowerAPI._ResolveTower(towerID)

    if not tower then
        return makeError(
            "Tower does not exist.",
            "TOWER_NOT_FOUND"
        )
    end

    local id = TowerAPI._GetTowerID(tower)
    local currentIndex = State.TowerTargets[id] or 1

    local steps = (desiredIndex - currentIndex) % #Config.TargetOrder

    if Config.DryRun then
        State.TowerTargets[id] = desiredIndex

        recordAction({
            Type = "SetTarget",
            Tower = id,
            Target = Config.TargetOrder[desiredIndex],
            Steps = steps,
        })

        return success({
            Target = Config.TargetOrder[desiredIndex],
            Steps = steps,
        })
    end

    for _ = 1, steps do
        local ok, result = pcall(function()
            return ChangeTargetRemote:InvokeServer(tower)
        end)

        if not ok then
            return makeError(
                result,
                "CHANGE_TARGET_FAILED"
            )
        end

        task.wait()
    end

    State.TowerTargets[id] = desiredIndex

    recordAction({
        Type = "SetTarget",
        Tower = id,
        Target = Config.TargetOrder[desiredIndex],
        Steps = steps,
    })

    return success({
        Target = Config.TargetOrder[desiredIndex],
        Steps = steps,
        ID = id,
    })
end


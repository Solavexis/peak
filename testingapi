    --  TELEPORT SYSTEM
    -- ═══════════════════════════════════════════════════════════
    API.Teleport = {}

    function API.Teleport.QueueScript(userScriptSource)
        local full = 'local API = loadstring(game:HttpGet("' .. API_URL .. '"))()\n' .. userScriptSource
        _queue_on_teleport(full)
    end

    function API.Teleport.QueueAPI(apiLoadstringSource)
        _queue_on_teleport(apiLoadstringSource)
        return true
    end

    function API.Teleport.AutoRejoin()
        _queue_on_teleport([[
            local TS = game:GetService("TeleportService")
            local Pl = game:GetService("Players")
            task.wait(3)
            TS:Teleport(]] .. game.PlaceId .. [[, Pl.LocalPlayer)
        ]])
    end

    function API.Teleport.QueueFarmLoop(fullScriptSource)
        _queue_on_teleport(fullScriptSource)
    end

    -- ═══════════════════════════════════════════════════════════
    --  EVENT LISTENERS
    -- ═══════════════════════════════════════════════════════════
    API.Events = {}

    --- Connect to message events (works in both lobby and game)
    function API.Events.OnMessage(callback)
        if API.IsLobby then
            local remote = getRemote({"Remotes", "Message"})
            if remote then
                remote.OnClientEvent:Connect(function(...) callback(...) end)
            end
        elseif API.IsInGame then
            local remote = getRemote({"Events", "Other", "Message"})
            if remote then
                remote.OnClientEvent:Connect(function(...) callback(...) end)
            end
        end
    end

    --- Fire when a new tower appears in workspace.Towers
    function API.Events.OnTowerPlaced(callback)
        local folder = WS:FindFirstChild("Towers")
        if folder then
            folder.ChildAdded:Connect(function(child) callback(child) end)
        else
            -- Deferred: wait for Towers folder to exist
            spawn(function()
                local f = WS:WaitForChild("Towers", 120)
                if f then f.ChildAdded:Connect(function(child) callback(child) end) end
            end)
        end
    end

    --- Fire when a tower is removed from workspace.Towers
    function API.Events.OnTowerRemoved(callback)
        local folder = WS:FindFirstChild("Towers")
        if folder then
            folder.ChildRemoved:Connect(function(child) callback(child) end)
        else
            spawn(function()
                local f = WS:WaitForChild("Towers", 120)
                if f then f.ChildRemoved:Connect(function(child) callback(child) end) end
            end)
        end
    end

    -- ═══════════════════════════════════════════════════════════
    --  DATA CACHE
    -- ═══════════════════════════════════════════════════════════
    API.Data = { Cached = {} }

    function API.Data.Refresh()
        if not API.IsLobby then return false end
        local raw = API.Lobby.GetData()
        if type(raw) ~= "table" then return false end

        -- Handle both {OwnedTowers=...} and {{OwnedTowers=...}}
        local d = raw.OwnedTowers and raw or (raw[1] and raw[1].OwnedTowers and raw[1])
        if type(d) ~= "table" then return false end

        API.Data.Cached        = d
        API.Data.OwnedTowers   = d.OwnedTowers   or {}
        API.Data.TowersEquipped = d.TowersEquipped or {}
        API.Data.Bricks        = d.Bricks        or 0
        API.Data.Bux           = d.Bux           or 0
        API.Data.Level         = d.Level         or 1
        API.Data.XP            = d.XP            or 0
        API.Data.BeatenMaps    = d.BeatenMaps    or {}
        API.Data.Beaten        = d.Beaten        or {}
        API.Data.OwnedSkins    = d.OwnedSkins    or {}
        API.Data.Mastery       = d.Mastery       or {}
        API.Data.Settings      = d.Settings      or {}
        API.Data.OwnedTags     = d.OwnedTags     or {}
        API.Data.EquippedTags  = d.Equippedtags  or d.EquippedTags or ""

        return true
    end

    -- Auto-cache on lobby
    if API.IsLobby then
        task.spawn(function()
            pcall(API.Data.Refresh)
        end)
    end

    -- ═══════════════════════════════════════════════════════════
    --  AUTO-FARM TEMPLATE
    -- ═══════════════════════════════════════════════════════════
    API.Farm = {}

    local farmState = { running = false, config = {} }

    function API.Farm.Start(config)
        --[[
            config = {
                modifiers    = {},          -- modifier table
                map          = "Baseplate", -- map name
                playerCount  = 1,
                difficulty   = "Easy",
                towers       = {
                    { name = "Battler", cframe = CFrame.new(...), expectedIndex = 1, upgrades = 2, delay = 1 },
                    ...
                },
                autoRestart  = true,
                restartDelay = 60,
            }
        ]]
        if farmState.running then return false end
        farmState.running = true
        farmState.config  = config or {}

        local cfg = farmState.config

        spawn(function()
            while farmState.running do
                task.wait(1)

                if game.PlaceId == PLACE_LOBBY then
                    -- Join match
                    API.Lobby.JoinElevator(cfg.modifiers or {}, cfg.map or "Baseplate", cfg.playerCount or 1)

                    -- Wait for teleport
                    local t = 30
                    while game.PlaceId ~= PLACE_INGAME and t > 0 and farmState.running do
                        task.wait(1)
                        t = t - 1
                    end

                elseif game.PlaceId == PLACE_INGAME then
                    -- Vote
                    if cfg.difficulty then
                        API.Game.Vote(cfg.difficulty)
                        task.wait(2)
                    end

                    -- Place towers
                    if cfg.towers then
                        for _, tc in ipairs(cfg.towers) do
                            if not farmState.running then break end

                            API.Game.PlaceTower(tc.name, tc.cframe)
                            task.wait(tc.delay or 1)

                            -- Upgrades
                            if tc.upgrades then
                                for u = 1, tc.upgrades do
                                    if not farmState.running then break end
                                    task.wait(tc.upgradeDelay or 2)
                                    API.Game.UpgradeTowerByIndex(tc.expectedIndex or u, tc.cframe)
                                end
                            end
                        end
                    end

                    -- Wait & restart
                    if cfg.autoRestart then
                        task.wait(cfg.restartDelay or 60)
                        API.Game.Restart()
                    end

                    -- Wait for teleport back to lobby
                    local t = 30
                    while game.PlaceId ~= PLACE_LOBBY and t > 0 and farmState.running do
                        task.wait(1)
                        t = t - 1
                    end
                end
            end
        end)

        return true
    end

    function API.Farm.Stop()
        farmState.running = false
    end

    function API.Farm.IsRunning()
        return farmState.running
    end

    -- ═══════════════════════════════════════════════════════════
    --  RETURN
    -- ═══════════════════════════════════════════════════════════
    return API
end)()

--//====================================================
--// CASH
--//====================================================

function TowerAPI.GetMoney()
	local leaderstats = LocalPlayer:FindFirstChild("leaderstats")

	if leaderstats then
		local cash = leaderstats:FindFirstChild("Cash")

		if cash then
			if cash:IsA("IntValue") or cash:IsA("NumberValue") then
				return cash.Value
			end
		end
	end

	-- GUI fallback.
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")

	if playerGui then
		local gameGUI = playerGui:FindFirstChild("GameGUI")

		if gameGUI then
			local stats = gameGUI:FindFirstChild("Stats")

			if stats then
				local cashFrame = stats:FindFirstChild("Cash")

				if cashFrame then
					local amount = cashFrame:FindFirstChild("Amount")

					if amount and amount:IsA("TextLabel") then
						local text = amount.Text

						-- Remove "$".
						text = text:gsub("%$", "")

						-- Remove commas.
						text = text:gsub(",", "")

						-- Remove spaces.
						text = text:gsub("%s+", "")

						local value = tonumber(text)

						if value then
							return value
						end
					end
				end
			end
		end
	end

	return nil
end



--// 
--// Original Revive Dupe code by upio
--// Method found by lolcat
--// Modified to use File I/O instead of Chat Communication
--// 

--// Services
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

--// Settings
local TPToLobby = TPToLobby or false 
local LeaveAfterDupe = LeaveAfterDupe or false 
local LOBBY_PLACE_ID = 6516141723

--// Remotes
local RemotesFolder = ReplicatedStorage.RemotesFolder
local ReviveFriendEvent = RemotesFolder.ReviveFriend
local ObtainReviveEvent = RemotesFolder.ObtainGiftedRevive

--// Player Variables
local LocalPlayer = Players.LocalPlayer
local OtherPlayer

local LatestRoom = ReplicatedStorage.GameData.LatestRoom
local Revives = LocalPlayer.PlayerGui.TopbarUI.Topbar.StatsTopbarHandler.StatModules.Revives.RevivesVal

local IsMainAccount = LocalPlayer.Name == AccountToDuplicateTo
local DuplicationCount = DuplicationAmount or 1000
local Title = IsMainAccount and "Revive Dupe Helper (Main Account)" or "Revive Dupe Helper (Alt Account)"

--// File Communication Variables
local ALTR_FILE = "ALTR"
local MAINR_FILE = "MAINR"
local IsGiftingRevive = false

--// Universal Leave Game Function
local function LeaveGame()
    if TPToLobby then
        TeleportService:Teleport(LOBBY_PLACE_ID, LocalPlayer)
    else
        game:Shutdown()
    end
end

--// File Functions
local function UpdateReviveFile(fileName, value)
    if isfile(fileName) then
        delfile(fileName)
    end
    writefile(fileName, tostring(value))
end

local function ReadReviveFile(fileName)
    if isfile(fileName) then
        local val = readfile(fileName)
        if tonumber(val) then
            return tonumber(val)
        end
    end
    return nil
end

--// ========================================================
--// EXECUTOR COMPATIBILITY CHECK
--// ========================================================
do
    local missingFunctions = {}

    if not isfile then table.insert(missingFunctions, "isfile") end
    if not delfile then table.insert(missingFunctions, "delfile") end
    if not writefile then table.insert(missingFunctions, "writefile") end
    if not readfile then table.insert(missingFunctions, "readfile") end

    if #missingFunctions > 0 then
        local errorMsg = "Script halted! Missing required File I/O: " .. table.concat(missingFunctions, ", ")
        warn(errorMsg)
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Executor Error",
                Text = errorMsg,
                Duration = 15
            })
        end)
        return 
    end

    if not hookmetamethod then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Missing Function",
                Text = "hookmetamethod missing. Using less stable fallback.",
                Duration = 10
            })
        end)
    end

    if not replicatesignal then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Missing Function",
                Text = "replicatesignal missing. You will need to die manually.",
                Duration = 10
            })
        end)
    end
end
--// ========================================================

--// Initialize files with current revive counts
if IsMainAccount then
    UpdateReviveFile(MAINR_FILE, Revives.Value)
else
    UpdateReviveFile(ALTR_FILE, Revives.Value)
end

local function GetOtherPlayer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            return player
        end
    end
    return nil
end

--// Main Account File Listener (Initial 0-revive gifting phase)
if IsMainAccount then
    task.spawn(function()
        while task.wait(0.5) do
            local altRevives = ReadReviveFile(ALTR_FILE)
            local mainRevives = Revives.Value

            if altRevives ~= nil and altRevives == 0 and mainRevives > 0 then
                IsGiftingRevive = true
                OtherPlayer = GetOtherPlayer()
                
                if not OtherPlayer then
                    continue
                end

                if OtherPlayer:GetAttribute("Alive") ~= false then
                    StarterGui:SetCore("SendNotification", {
                        Title = Title,
                        Text = "Waiting for the other account to die...",
                        Duration = 5
                    })
                    repeat task.wait(0.5) until OtherPlayer:GetAttribute("Alive") == false
                end

                task.wait(1)
                
                StarterGui:SetCore("SendNotification", {
                    Title = Title,
                    Text = "Sending revive to alt account...",
                    Duration = 3
                })
                
                ReviveFriendEvent:FireServer(OtherPlayer.Name)
                UpdateReviveFile(MAINR_FILE, Revives.Value)
                
                StarterGui:SetCore("SendNotification", {
                    Title = Title,
                    Text = "Revive sent! Waiting for Alt to leave...",
                    Duration = 5
                })

                if OtherPlayer then
                    OtherPlayer.AncestryChanged:Wait()
                end

                task.wait(0.5)
                LeaveGame()
                break
            end
        end
    end)
end

task.spawn(function()
    while not OtherPlayer do
        OtherPlayer = GetOtherPlayer()
        if not OtherPlayer then
            task.wait(1)
        end
    end
end)

--// Functions
local function AttemptToKillLocalPlayer()
    if LatestRoom.Value == 0 then
        StarterGui:SetCore("SendNotification", {
            Title = "Revive Dupe Helper",
            Text = "Please open a door",
            Duration = 5
        })
        LatestRoom:GetPropertyChangedSignal("Value"):Wait()
    end

    if replicatesignal then
        replicatesignal(LocalPlayer.Kill)
    else
        StarterGui:SetCore("SendNotification", {
            Title = "Revive Dupe Helper",
            Text = "replicatesignal missing. Please die manually.",
            Duration = 5
        })
        if LocalPlayer.Character then
            LocalPlayer.Character:WaitForChild("Humanoid").Died:Wait()
        end
    end
end

--// Gifting 1 revive to alt account process (ALT SIDE)
if Revives.Value == 0 and not IsMainAccount then
    IsGiftingRevive = true

    UpdateReviveFile(ALTR_FILE, 0)

    AttemptToKillLocalPlayer()
    
    StarterGui:SetCore("SendNotification", {
        Title = Title,
        Text = "Waiting for the other account to gift you a revive...",
        Duration = 5
    })
    
    local function OnReceiveRevive(...)
        UpdateReviveFile(ALTR_FILE, Revives.Value)
        task.wait(0.1)
        LeaveGame()
        return true
    end

    if hookmetamethod then
        local mtHook; mtHook = hookmetamethod(game, "__newindex", function(...)
            local self, key = ...
            if rawequal(self, ObtainReviveEvent) and key == "OnClientInvoke" then
                if not checkcaller() then
                    return
                end
            end
            return mtHook(...)
        end)
    end

    ObtainReviveEvent.OnClientInvoke = OnReceiveRevive
end

task.wait(2)

if IsGiftingRevive then
    return
end

--// ========================================================
--// MAIN DUPLICATION PHASE (100% INSTANT)
--// ========================================================
if IsMainAccount then
    local ReviveObtainedAmount = 0
    
    -- Changed 0.85 to 0.1 so it doesn't permanently freeze if Roblox drops too many packets
    local threshold = math.clamp(DuplicationCount * 0.1, 1, DuplicationCount) 
    
    local function OnObtainRevive(...)
        ReviveObtainedAmount += 1

        if ReviveObtainedAmount >= threshold then
            if LeaveAfterDupe then
                task.spawn(function()
                    task.wait(10)
                    UpdateReviveFile(MAINR_FILE, Revives.Value) 
                    LeaveGame()
                end)
            end
            return true
        end

        task.wait(9e9) -- Hold the remote to allow duping
        return true
    end

    if hookmetamethod then
        local mtHook; mtHook = hookmetamethod(game, "__newindex", function(...)
            local self, key = ...
            if rawequal(self, ObtainReviveEvent) and key == "OnClientInvoke" then
                if not checkcaller() then
                    return
                end
            end
            return mtHook(...)
        end)
    else
        task.defer(function()
            while task.wait() do
                ObtainReviveEvent.OnClientInvoke = OnObtainRevive
            end
        end)
    end

    ObtainReviveEvent.OnClientInvoke = OnObtainRevive

    AttemptToKillLocalPlayer()
else
    -- ALT ACCOUNT DUPLICATION PHASE (100% INSTANT, ZERO WAITS)
    while not OtherPlayer do task.wait() end

    if OtherPlayer:GetAttribute("Alive") then
        StarterGui:SetCore("SendNotification", {
            Title = Title,
            Text = "Waiting for the other account to die...",
            Duration = 5
        })
        OtherPlayer:GetAttributeChangedSignal("Alive"):Wait()
    end

    for i = 1, 5 do
        StarterGui:SetCore("SendNotification", {
            Title = Title,
            Text = `Duping in {6 - i} seconds...`,
            Duration = 1
        })
        task.wait(1)
    end

    -- PURE INSTANT EXECUTION. No task.wait() batching.
    for i = 1, DuplicationCount do
        ReviveFriendEvent:FireServer(OtherPlayer.Name)
    end

    StarterGui:SetCore("SendNotification", {
        Title = Title,
        Text = "Duping completed!",
        Duration = 5
    })

    if LeaveAfterDupe then
        StarterGui:SetCore("SendNotification", {
            Title = Title,
            Text = "Waiting for Main account to leave...",
            Duration = 5
        })
        
        if OtherPlayer then
            while Players:FindFirstChild(OtherPlayer.Name) do
                task.wait(0.5)
            end
        end
        
        LeaveGame()
    end
end

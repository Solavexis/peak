--==================================================
-- AUTOMATIC TOWER TRACKING
--==================================================

local function setupTowerTracking()
    local folder = getTowersFolder()

    if not folder then
        warn("[TowerAPI] workspace.Towers was not found.")
        return
    end

    for _, tower in ipairs(folder:GetChildren()) do
        if isTowerInstance(tower) then
            local id = TowerAPI._GetTowerID(tower)

            State.Towers[id] = {
                Instance = tower,
                ID = id,
                Attributes = getTowerAttributes(tower),
            }

            if not State.TowerTargets[id] then
                State.TowerTargets[id] = 1
            end
        end
    end

    folder.ChildAdded:Connect(function(tower)
        if not isTowerInstance(tower) then
            return
        end

        local id = TowerAPI._GetTowerID(tower)

        State.Towers[id] = {
            Instance = tower,
            ID = id,
            Attributes = getTowerAttributes(tower),
        }

        -- New tower always gets its own target state.
        State.TowerTargets[id] = 1

        Events.OnTowerAdded:Fire(id, tower)

        debugPrint(
            "Tower added:",
            id,
            tower.Name
        )
    end)

    folder.ChildRemoved:Connect(function(tower)
        for id, instance in pairs(State.TowerInstances) do
            if instance == tower then
                State.TowerInstances[id] = nil
                State.Towers[id] = nil
                State.TowerTargets[id] = nil

                Events.OnTowerRemoved:Fire(id, tower)

                debugPrint(
                    "Tower removed:",
                    id
                )

                break
            end
        end
    end)
end

setupTowerTracking()

TowerAPI.RefreshTowers()

debugPrint("TowerAPI loaded.")

return TowerAPI

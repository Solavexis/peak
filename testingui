-- MACRO TAB
---------------------------------------------------------------------
local Macro = Window:Tab({ Title = "Macros", Icon = "circle-dot" })

Macro:Section({ Title = "Record" })
Macro:Input({ Title = "Macro name", Value = "run1", Callback = function(v) S.macroName = v end })
local macroDD
local function refreshMacros()
    if macroDD then refresh(macroDD, orNone(TD.ListMacros())) end
end
Macro:Button({
    Title = "Start recording",
    Desc = "Now vote/place/upgrade like normal - everything is captured",
    Callback = function()
        local name = (S.macroName ~= "" and S.macroName) or ("macro_" .. os.time())
        handle(TD.StartRecording(name), "Recording '" .. name .. "'")
    end,
})
Macro:Button({
    Title = "Stop & save",
    Callback = function()
        local r = handle(TD.StopRecording(true))
        if r and r.Success then
            notify("Saved", #r.Data.entries .. " steps", "check")
            refreshMacros()
        end
    end,
})
Macro:Button({
    Title = "Stop (discard)",
    Callback = function() handle(TD.StopRecording(false), "Discarded") end,
})

Macro:Section({ Title = "Replay" })
macroDD = Macro:Dropdown({
    Title = "Saved macros",
    Values = orNone(TD.ListMacros()),
    Value = TD.ListMacros()[1] or "(none)",
    Callback = function(v) S.macro = v end,
})
S.macro = TD.ListMacros()[1]
Macro:Button({ Title = "Refresh list", Callback = refreshMacros })
Macro:Dropdown({
    Title = "Playback mode",
    Values = { "Timed", "Fast" },
    Value = "Timed",
    Callback = function(v) S.mode = v end,
})
Macro:Slider({
    Title = "Retries per step",
    Step = 1,
    Value = { Min = 1, Max = 100, Default = 30 },
    Callback = function(v) S.retries = v end,
})
local function needMacro()
    if not S.macro or S.macro == "(none)" then notify("Pick a macro", "Nothing selected.", "x") return false end
    return true
end
Macro:Button({
    Title = "Play",
    Callback = function()
        if not needMacro() then return end
        handle(TD.Play(S.macro, {
            Mode = S.mode,
            Retries = S.retries,
            OnDone = function(completed) notify("Macro", completed and "Finished" or "Stopped", completed and "check" or "square") end,
        }), "Playing '" .. S.macro .. "'")
    end,
})
Macro:Button({ Title = "Stop playback", Callback = function() TD.Stop() notify("Macro", "Stopping...", "square") end })
Macro:Button({
    Title = "Delete selected",
    Callback = function()
        if needMacro() and handle(TD.DeleteMacro(S.macro), "Deleted") then
            S.macro = nil
            refreshMacros()
        end
    end,
})


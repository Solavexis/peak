ReplicatedStorage.Events.RemoteEvents.WinOrLose.OnClientEvent:Connect(function(didWin, exp, ...)
    if allStagesComplete then return end
    
    local stageConfig = getCurrentStageInfo()
    if not stageConfig then return end
    
    Stats.BattlesCompleted = Stats.BattlesCompleted + 1

    if didWin then
        Stats.Wins = Stats.Wins + 1
        Stats.WinStreak = Stats.WinStreak + 1
        Stats.BestWinStreak = math.max(Stats.BestWinStreak, Stats.WinStreak)
        
        local expGained = exp or 0
        Stats.TotalEXP = Stats.TotalEXP + expGained
        currentStageEXP = currentStageEXP + expGained
        table.insert(Stats.RecentEXP, expGained)
        
        if #Stats.RecentEXP > 50 then
            table.remove(Stats.RecentEXP, 1)
        end
        
        currentStageWins = currentStageWins + 1
        
        print(string.format("[WIN] +%.0f EXP | Stage %d/%d | %d/%d wins | Total: %.0f", 
            expGained, currentStageIndex, #StageQueue, currentStageWins, stageConfig.WinsNeeded, Stats.TotalEXP))

        if currentStageWins >= stageConfig.WinsNeeded then

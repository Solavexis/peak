--==================================================
-- CONDITIONS
--==================================================

function TowerAPI.Wait(seconds)
    seconds = tonumber(seconds) or 0

    if seconds > 0 then
        task.wait(seconds)
    end

    recordAction({
        Type = "Wait",
        Duration = seconds,
    })

    return success()
end

function TowerAPI.WaitForMoney(amount, timeout)
    amount = tonumber(amount)

    if not amount then
        return makeError(
            "Amount must be a number.",
            "INVALID_AMOUNT"
        )
    end

    timeout = timeout or Config.DefaultTimeout

    local start = os.clock()

    while os.clock() - start < timeout do
        local money = TowerAPI.GetMoney()

        if money and money >= amount then
            return success({
                Money = money,
            })
        end

        task.wait(Config.ConditionInterval)
    end

    return makeError(
        "Timed out waiting for money.",
        "WAIT_MONEY_TIMEOUT"
    )
end

function TowerAPI.WaitForTower(towerID, timeout)
    timeout = timeout or Config.DefaultTimeout

    local start = os.clock()

    while os.clock() - start < timeout do
        local tower = TowerAPI._ResolveTower(towerID)

        if tower then
            return success({
                Tower = tower,
            })
        end

        task.wait(Config.ConditionInterval)
    end

    return makeError(
        "Timed out waiting for tower.",
        "WAIT_TOWER_TIMEOUT"
    )
end

--==================================================
-- REPLAY
--==================================================

local function executeAction(action)
    if not action or not action.Type then
        return makeError(
            "Invalid replay action.",
            "INVALID_REPLAY_ACTION"
        )
    end

    if action.Type == "Place" then
        local cf = deserializeCFrame(action.CFrame)

        if not cf then
            return makeError(
                "Invalid Place CFrame.",
                "INVALID_REPLAY_CFRAME"
            )
        end

        return TowerAPI.Place(
            action.TowerName,
            cf
        )

    elseif action.Type == "Upgrade" then
        local cf = deserializeCFrame(action.CFrame)

        if not cf then
            return makeError(
                "Invalid Upgrade CFrame.",
                "INVALID_REPLAY_CFRAME"
            )
        end

        return TowerAPI.Upgrade(
            action.Tower,
            cf
        )

    elseif action.Type == "Sell" then
        return TowerAPI.Sell(action.Tower)

    elseif action.Type == "Ability" then
        return TowerAPI.UseAbility(action.Tower)

    elseif action.Type == "CycleTarget" then
        return TowerAPI.CycleTarget(action.Tower)

    elseif action.Type == "SetTarget" then
        return TowerAPI.SetTarget(
            action.Tower,
            action.Target
        )

    elseif action.Type == "Skip" then
        return TowerAPI.Skip()

    elseif action.Type == "Restart" then
        return TowerAPI.Restart()

    elseif action.Type == "Vote" then
        return TowerAPI.Vote(action.Mode)

    elseif action.Type == "ElevatorSetup" then
        return TowerAPI.FinishElevatorSetup(
            action.Map,
            action.PlayerAmount,
            action.Modifiers
        )

    elseif action.Type == "Wait" then
        return TowerAPI.Wait(action.Duration)

    elseif action.Type == "WaitForMoney" then
        return TowerAPI.WaitForMoney(
            action.Amount,
            action.Timeout
        )
    end

    return makeError(
        "Unknown replay action: " .. tostring(action.Type),
        "UNKNOWN_REPLAY_ACTION"
    )
end

function TowerAPI.StartReplay(replay, options)
    if State.Replaying then
        return makeError(
            "Already replaying.",
            "ALREADY_REPLAYING"
        )
    end

    if type(replay) ~= "table" then
        return makeError(
            "Replay must be a table.",
            "INVALID_REPLAY"
        )
    end

    if type(replay.Actions) ~= "table" then
        return makeError(
            "Replay has no Actions table.",
            "INVALID_REPLAY"
        )
    end

    options = options or {}

    State.Replaying = true
    State.Paused = false
    State.CurrentReplay = replay
    State.ReplayToken += 1

    local token = State.ReplayToken

    Events.OnReplayStart:Fire(replay)

    task.spawn(function()
        local previousTime = 0

        for index, action in ipairs(replay.Actions) do
            if not State.Replaying or token ~= State.ReplayToken then
                break
            end

            State.CurrentAction = index

            while State.Paused and State.Replaying do
                task.wait(0.05)
            end

            if not State.Replaying then
                break
            end

            -- Timing is only used as a baseline.
            -- Actions themselves are still executed sequentially.
            if options.UseTiming ~= false and action.Time then
                local delayTime = math.max(
                    0,
                    action.Time - previousTime
                )

                if delayTime > 0 then
                    task.wait(delayTime)
                end

                previousTime = action.Time
            end

            local result = executeAction(action)

            if type(result) == "table" and result.Success == false then
                Events.OnError:Fire(result)
                break
            end
        end

        local finished = State.Replaying

        State.Replaying = false
        State.Paused = false

        if finished then
            Events.OnReplayFinished:Fire(replay)
        end
    end)

    return success()
end

function TowerAPI.PauseReplay()
    if not State.Replaying then
        return makeError(
            "Nothing is being replayed.",
            "NOT_REPLAYING"
        )
    end

    State.Paused = true

    return success()
end

function TowerAPI.ResumeReplay()
    if not State.Replaying then
        return makeError(
            "Nothing is being replayed.",
            "NOT_REPLAYING"
        )
    end

    State.Paused = false

    return success()
end

function TowerAPI.StopReplay()
    if not State.Replaying then
        return makeError(
            "Nothing is being replayed.",
            "NOT_REPLAYING"
        )
    end

    State.Replaying = false
    State.Paused = false
    State.ReplayToken += 1

    Events.OnReplayStopped:Fire()

    return success()
end


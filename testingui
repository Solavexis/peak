-- AUTO-RUN TAB
---------------------------------------------------------------------
local Auto = Window:Tab({ Title = "Auto-run", Icon = "repeat" })
Auto:Paragraph({
    Title = "How it works",
    Desc = "Uses the Elevator/Map/Mods/Players you chose in the Lobby tab and the macro chosen in Macros.\n"
        .. "After every teleport the UI is re-queued, joins the elevator in the lobby, and plays the macro in-game.",
})
Auto:Toggle({ Title = "Auto join elevator (lobby)", Value = true, Callback = function(v) S.autoJoin = v end })
Auto:Toggle({ Title = "Auto play macro (in-game)", Value = true, Callback = function(v) S.autoPlay = v end })
Auto:Toggle({
    Title = "Re-queue UI on teleport",
    Value = true,
    Callback = function(v) S.queueUI = v if v then queueUI() end end,
})
Auto:Button({
    Title = "Save auto-run config",
    Callback = function()
        local cfg = {}
        if S.autoJoin then
            if not S.map or S.map == "(none)" then notify("Pick a map", "Choose a map in the Lobby tab.", "x") return end
            cfg.AutoJoin = { Elevator = S.elevator, Map = S.map, Mods = cleanMods(), Players = S.players }
        end
        if S.autoPlay then
            if not S.macro or S.macro == "(none)" then notify("Pick a macro", "Choose a macro in the Macros tab.", "x") return end
            cfg.AutoPlay = { Macro = S.macro, Mode = S.mode }
        end
        handle(TD.SetAutoRun(cfg), "Auto-run saved")
    end,
})
Auto:Button({ Title = "Clear auto-run", Callback = function() handle(TD.ClearAutoRun(), "Auto-run cleared") end })


--//====================================================
--// CONDITIONS
--//====================================================

function TowerAPI.Wait(seconds)
	seconds = tonumber(seconds)

	if not seconds then
		return makeError(
			"INVALID_WAIT",
			"Wait time must be a number."
		)
	end

	task.wait(
		math.max(0, seconds)
	)

	return true
end


function TowerAPI.WaitForMoney(
	requiredAmount,
	timeout
)
	requiredAmount = tonumber(requiredAmount)

	if not requiredAmount then
		return makeError(
			"INVALID_MONEY_AMOUNT",
			"Required money must be a number."
		)
	end

	timeout = tonumber(timeout)
		or Config.DefaultTimeout

	local start = os.clock()

	while true do
		if State.Paused then
			task.wait(
				Config.ConditionInterval
			)

			continue
		end

		local currentCash = TowerAPI.GetMoney()

		if currentCash and currentCash >= requiredAmount then
			return true, currentCash
		end

		if os.clock() - start >= timeout then
			return false, makeError(
				"MONEY_TIMEOUT",

				string.format(
					"Did not reach $%d within %.2f seconds. Current cash: %s",

					requiredAmount,

					timeout,

					tostring(
						currentCash or "unknown"
					)
				)
			)
		end

		task.wait(
			Config.ConditionInterval
		)
	end
end


function TowerAPI.WaitForTower(
	towerID,
	timeout
)
	timeout = tonumber(timeout)
		or Config.DefaultTimeout

	local start = os.clock()

	while os.clock() - start < timeout do
		local tower = TowerAPI._ResolveTower(
			towerID
		)

		if tower then
			return true, tower
		end

		task.wait(
			Config.ConditionInterval
		)
	end

	return false, makeError(
		"TOWER_TIMEOUT",
		"Tower did not appear within " .. tostring(timeout) .. " seconds."
	)
end


--//====================================================
--// REPLAY EXECUTION
--//====================================================

function TowerAPI._ExecuteAction(action)
	if type(action) ~= "table" then
		return false, makeError(
			"INVALID_ACTION",
			"Replay action is not a table."
		)
	end

	local actionType = action.Type

	if actionType == "Place" then
		local cf = deserializeCFrame(
			action.CFrame
		)

		if not cf then
			return false, makeError(
				"INVALID_REPLAY_CFRAME",
				"Invalid Place CFrame."
			)
		end

		local result = TowerAPI.Place(
			action.TowerName,
			cf
		)

		return result ~= nil, result


	elseif actionType == "Upgrade" then
		local cf

		if action.CFrame then
			cf = deserializeCFrame(
				action.CFrame
			)
		end

		local result = TowerAPI.Upgrade(
			action.Tower,
			cf
		)

		return result ~= nil, result


	elseif actionType == "Sell" then
		local result = TowerAPI.Sell(
			action.Tower
		)

		return result ~= nil, result


	elseif actionType == "Ability" then
		local result = TowerAPI.UseAbility(
			action.Tower
		)

		return result ~= nil, result


	elseif actionType == "SetTarget" then
		local result = TowerAPI.SetTarget(
			action.Tower,
			action.Target
		)

		return result == true, result


	elseif actionType == "Skip" then
		local result = TowerAPI.Skip()

		return result == true, result


	elseif actionType == "Restart" then
		local result = TowerAPI.Restart()

		return result == true, result


	elseif actionType == "Vote" then
		local result = TowerAPI.Vote(
			action.Mode
		)

		return result == true, result


	elseif actionType == "ElevatorSetup" then
		local result = TowerAPI.FinishElevatorSetup(
			action.Map,
			action.PlayerAmount,
			action.Modifiers
		)

		return result == true, result


	elseif actionType == "Wait" then
		local result = TowerAPI.Wait(
			action.Duration
		)

		return result == true, result


	elseif actionType == "WaitForMoney" then
		local result = TowerAPI.WaitForMoney(
			action.Amount,
			action.Timeout
		)

		return result == true, result
	end

	return false, makeError(
		"UNKNOWN_ACTION",
		"Unknown replay action: " .. tostring(actionType)
	)
end


--//====================================================
--// REPLAY
--//====================================================

function TowerAPI.StartReplay(replay)
	if State.Replaying then
		return makeError(
			"ALREADY_REPLAYING",
			"A replay is already running."
		)
	end

	if type(replay) ~= "table" then
		return makeError(
			"INVALID_REPLAY",
			"Replay must be a table."
		)
	end

	if type(replay.Actions) ~= "table" then
		return makeError(
			"INVALID_REPLAY_ACTIONS",
			"Replay has no Actions table."
		)
	end

	State.Replaying = true
	State.Paused = false

	State.CurrentReplay = replay

	State.CurrentAction = 0

	State.ReplayToken += 1

	local token = State.ReplayToken

	TowerAPI.Events.OnReplayStart:Fire(
		replay
	)

	debugPrint(
		"Replay started:",
		#replay.Actions,
		"actions"
	)

	task.spawn(function()
		for index, action in ipairs(replay.Actions) do
			if not State.Replaying then
				break
			end

			if token ~= State.ReplayToken then
				break
			end

			State.CurrentAction = index

			while State.Paused and State.Replaying do
				task.wait(
					Config.ConditionInterval
				)
			end

			if not State.Replaying then
				break
			end

			-- Optional recorded delay.
			if index > 1 then
				local previous = replay.Actions[index - 1]

				if action.Time and previous.Time then
					local delayTime =
						action.Time - previous.Time

					if delayTime > 0 then
						local start = os.clock()

						while os.clock() - start < delayTime do
							if not State.Replaying then
								break
							end

							while State.Paused and State.Replaying do
								task.wait(
									Config.ConditionInterval
								)
							end

							task.wait(
								math.min(
									0.05,
									delayTime
										- (os.clock() - start)
								)
							)
						end
					end
				end
			end

			local ok, result =
				TowerAPI._ExecuteAction(action)

			if not ok then
				State.Replaying = false

				TowerAPI.Events.OnReplayStopped:Fire(
					result
				)

				return
			end
		end

		if State.Replaying then
			State.Replaying = false

			TowerAPI.Events.OnReplayFinished:Fire(
				replay
			)

			debugPrint("Replay finished.")
		end
	end)

	return true
end


function TowerAPI.PauseReplay()
	if not State.Replaying then
		return makeError(
			"NOT_REPLAYING",
			"There is no active replay."
		)
	end

	State.Paused = true

	return true
end


function TowerAPI.ResumeReplay()
	if not State.Replaying then
		return makeError(
			"NOT_REPLAYING",
			"There is no active replay."
		)
	end

	State.Paused = false

	return true
end


function TowerAPI.StopReplay()
	if not State.Replaying then
		return makeError(
			"NOT_REPLAYING",
			"There is no active replay."
		)
	end

	State.Replaying = false
	State.Paused = false

	State.ReplayToken += 1

	TowerAPI.Events.OnReplayStopped:Fire(
		"Stopped"
	)

	return true
end


function TowerAPI.GetCurrentAction()
	return State.CurrentAction
end


--//====================================================
--// REPLAY JSON
--//====================================================

function TowerAPI.Serialize(replay)
	if type(replay) ~= "table" then
		return nil, makeError(
			"INVALID_REPLAY",
			"Cannot serialize non-table replay."
		)
	end

	local ok, result = pcall(function()
		return HttpService:JSONEncode(
			replay
		)
	end)

	if not ok then
		return nil, makeError(
			"SERIALIZE_FAILED",
			"JSON serialization failed: " .. tostring(result)
		)
	end

	return result
end


function TowerAPI.Deserialize(json)
	if type(json) ~= "string" then
		return nil, makeError(
			"INVALID_JSON",
			"Replay data must be a string."
		)
	end

	local ok, result = pcall(function()
		return HttpService:JSONDecode(
			json
		)
	end)

	if not ok then
		return nil, makeError(
			"DESERIALIZE_FAILED",
			"JSON decoding failed: " .. tostring(result)
		)
	end

	if type(result) ~= "table" then
		return nil, makeError(
			"INVALID_REPLAY",
			"Decoded JSON is not a replay table."
		)
	end

	if result.Format ~= "TowerReplay" then
		return nil, makeError(
			"INVALID_REPLAY_FORMAT",
			"Not a TowerReplay file."
		)
	end

	return result
end


function TowerAPI.Export(replay)
	replay = replay or State.CurrentReplay

	if not replay then
		return nil, makeError(
			"NO_REPLAY",
			"There is no replay to export."
		)
	end

	return TowerAPI.Serialize(
		replay
	)
end


function TowerAPI.Import(json)
	return TowerAPI.Deserialize(
		json
	)
end


--//====================================================
--// TELEPORT QUEUE
--//====================================================

function TowerAPI.QueueReplay(
	replay,
	nextAction
)
	if type(replay) ~= "table" then
		return makeError(
			"INVALID_REPLAY",
			"Replay must be a table."
		)
	end

	State.TeleportQueue = {
		Replay = deepCopy(replay),

		NextAction = tonumber(nextAction)
			or 1,
	}

	return true
end


function TowerAPI.GetTeleportQueue()
	if not State.TeleportQueue then
		return nil
	end

	return deepCopy(
		State.TeleportQueue
	)
end


function TowerAPI.ClearTeleportQueue()
	State.TeleportQueue = nil
end


function TowerAPI.Teleport(
	placeId,
	replay,
	nextAction,
	teleportData
)
	placeId = tonumber(placeId)

	if not placeId then
		return makeError(
			"INVALID_PLACE_ID",
			"Place ID must be a number."
		)
	end

	if replay then
		State.TeleportQueue = {
			Replay = deepCopy(replay),

			NextAction = tonumber(nextAction)
				or 1,
		}
	end

	local data = teleportData or {}

	if State.TeleportQueue then
		data.TowerAPI = {
			Replay = State.TeleportQueue.Replay,

			NextAction =
				State.TeleportQueue.NextAction,
		}
	end

	TowerAPI.Events.OnTeleport:Fire(
		data
	)

	-- Client teleport API.
	local ok, err = pcall(function()
		TeleportService:Teleport(
			placeId,

			LocalPlayer,

			data
		)
	end)

	if not ok then
		return makeError(
			"TELEPORT_FAILED",
			"Teleport failed: " .. tostring(err)
		)
	end

	return true
end


--//====================================================
--// RESTORE TELEPORT REPLAY
--//====================================================

function TowerAPI.GetTeleportData()
	local ok, data = pcall(function()
		return TeleportService:GetLocalPlayerTeleportData()
	end)

	if not ok then
		return nil
	end

	if type(data) ~= "table" then
		return nil
	end

	return data
end


function TowerAPI.ResumeTeleportReplay()
	local data = TowerAPI.GetTeleportData()

	if not data then
		return false
	end

	if type(data.TowerAPI) ~= "table" then
		return false
	end

	local replay = data.TowerAPI.Replay

	local nextAction =
		tonumber(data.TowerAPI.NextAction)
		or 1

	if type(replay) ~= "table" then
		return false
	end

	local newReplay = deepCopy(replay)

	if nextAction > 1 then
		local actions = {}

		for index = nextAction, #newReplay.Actions do
			table.insert(
				actions,
				newReplay.Actions[index]
			)
		end

		newReplay.Actions = actions
	end

	State.TeleportQueue = nil

	return TowerAPI.StartReplay(
		newReplay
	)
end



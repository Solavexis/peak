--// AUTOMATIC TOWER TRACKING
--//====================================================

local towersFolder = getTowersFolder()

if towersFolder then
	towersFolder.ChildAdded:Connect(function(tower)
		task.defer(function()
			if tower and tower.Parent then
				TowerAPI._GetTowerID(tower)
			end
		end)
	end)

	towersFolder.ChildRemoved:Connect(function(tower)
		for id, instance in pairs(State.TowerInstances) do
			if instance == tower then
				State.TowerInstances[id] = nil

				if State.Towers[id] then
					State.Towers[id].Instance = nil
				end
			end
		end
	end)
end



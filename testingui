    -- safety
    repair = true,
    repairMax = TD.RepairOptions.MaxRepairs,
    repairSellWindow = TD.RepairOptions.SellWindow,
    repairCheckMoney = TD.RepairOptions.CheckMoney,
    delays = { Place = TD.Delays.Place, Upgrade = TD.Delays.Upgrade, Any = TD.Delays.Any },
}

local function notify(title, content, icon)
    pcall(function()
        WindUI:Notify({ Title = title, Content = tostring(content), Duration = 3, Icon = icon or "info" })
    end)
end

-- shows a toast for an API result
local function handle(r, okMsg)
    if r == nil then return end
    if r.Success then
        if okMsg then notify("Success", okMsg, "check") end
    else
        notify("Error", (r.Error or "unknown") .. " [" .. tostring(r.Code) .. "]", "x")
    end
    return r
end

local function orNone(list)
    if #list == 0 then return { "(none)" } end
    return list
end

local function cleanMods()
    local out = {}
    for _, m in ipairs(S.mods) do if m ~= "(none)" then table.insert(out, m) end end
    return out
end

local function queueUI()
    if S.queueUI then
        local r = TD.QueueOnTeleport(string.format("loadstring(game:HttpGet(%q))()", UI_URL))
        if not r.Success then notify("Queue failed", r.Error, "x") end
    end
end
queueUI()

-- snapshots of the safety settings, used for Play() and the saved auto-run config
local function repairOptions()
    return { MaxRepairs = S.repairMax, SellWindow = S.repairSellWindow, CheckMoney = S.repairCheckMoney }
end
local function delayOptions()
    return { Place = S.delays.Place, Upgrade = S.delays.Upgrade, Any = S.delays.Any }
end

-- push current safety settings into the API right now
local function applySafety()
    TD.SetDelays(delayOptions())
    for k, v in pairs(repairOptions()) do TD.RepairOptions[k] = v end
end
applySafety()


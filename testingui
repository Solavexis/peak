    if not S.tower or S.tower == "(fetch first)" then notify("Pick a tower", "Refresh and select one.", "x") return false end
    return true
end
Lobby:Button({ Title = "Equip", Callback = function() if needTower() then handle(TD.Equip(S.tower), "Equipped " .. S.tower) end end })
Lobby:Button({ Title = "Unequip", Callback = function() if needTower() then handle(TD.Unequip(S.tower), "Unequipped " .. S.tower) end end })
Lobby:Button({
    Title = "Raw interact (toggle)",
    Callback = function()
        if needTower() then
            local r = handle(TD.Interact(S.tower))
            if r and r.Success then notify("Result", r.Data) end
        end
    end,
})

Lobby:Section({ Title = "Elevator" })
Lobby:Dropdown({
    Title = "Elevator type",
    Values = TD.GetElevatorTypes(),
    Value = "Main",
    Callback = function(v) S.elevator = v end,
})
local mapDD = Lobby:Dropdown({
    Title = "Map",
    Values = orNone(TD.GetMaps()),
    Value = (TD.GetMaps()[1]) or "(none)",
    Callback = function(v) S.map = v end,
})
S.map = TD.GetMaps()[1]
local modDD = Lobby:Dropdown({
    Title = "Modifiers",
    Values = orNone(TD.GetMods()),
    Value = {},
    Multi = true,
    AllowNone = true,
    Callback = function(v) S.mods = (type(v) == "table") and v or { v } end,
})
Lobby:Slider({
    Title = "Players",
    Step = 1,
    Value = { Min = 1, Max = 4, Default = 1 },
    Callback = function(v) S.players = v end,
})
Lobby:Button({
    Title = "Refresh maps / mods",
    Callback = function()
        refresh(mapDD, orNone(TD.GetMaps()))
        refresh(modDD, orNone(TD.GetMods()))
    end,
})
Lobby:Button({
    Title = "Join elevator + setup",
    Desc = "firetouchinterest on the entrance, then FinishSetup",
    Callback = function()
        if not S.map or S.map == "(none)" then notify("Pick a map", "Select a map first.", "x") return end
        handle(TD.JoinElevator(S.elevator, { Map = S.map, Mods = cleanMods(), Players = S.players }), "Joined " .. S.elevator)
    end,
})
Lobby:Button({
    Title = "Only send FinishSetup",
    Callback = function()
        if not S.map or S.map == "(none)" then notify("Pick a map", "Select a map first.", "x") return end
        handle(TD.FinishSetup(S.map, cleanMods(), S.players), "Setup sent")
    end,
})

Lobby:Section({ Title = "Fake client message (firesignal)" })
local msgText = "You need 299 more bricks to buy this tower."
Lobby:Input({ Title = "Message", Value = msgText, Callback = function(v) msgText = v end })
Lobby:Button({ Title = "Show message", Callback = function() handle(TD.Notify(msgText)) end })


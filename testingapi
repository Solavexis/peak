function TowerAPI.GetLobbyState()
	local data, dataError = TowerAPI.GetData()

	if not data then
		return nil, dataError
	end

	local modifiers, modifierError = TowerAPI.GetModifiers()

	if not modifiers then
		return nil, modifierError
	end

	return {
		Data = data,

		Maps = TowerAPI.GetMapNames(),

		Modifiers = modifiers,

		Level = data.Level,

		XP = data.XP,

		Bux = data.Bux,

		Bricks = data.Bricks,

		Cash = TowerAPI.GetMoney(),

		OwnedTowers = data.OwnedTowers or {},

		TowersEquipped = data.TowersEquipped or {},

		OwnedSkins = data.OwnedSkins or {},

		EquippedSkins = data.EquippedSkins or {},

		Beaten = data.Beaten or {},

		BeatenMaps = data.BeatenMaps or {},

		Settings = data.Settings or {},
	}
end


--//====================================================
--// ELEVATOR
--//====================================================

function TowerAPI.FinishElevatorSetup(
	mapName,
	playerAmount,
	modifiers
)
	if type(mapName) ~= "string" then
		return makeError(
			"INVALID_MAP",
			"Map name must be a string."
		)
	end

	playerAmount = tonumber(playerAmount)

	if not playerAmount then
		return makeError(
			"INVALID_PLAYER_AMOUNT",
			"Player amount must be a number."
		)
	end

	if type(modifiers) ~= "table" then
		modifiers = {}
	end

	if Config.DryRun then
		debugPrint(
			"[DRY RUN] Elevator FinishSetup:",
			mapName,
			playerAmount
		)

		recordAction({
			Type = "ElevatorSetup",

			Map = mapName,

			PlayerAmount = playerAmount,

			Modifiers = deepCopy(modifiers),
		})

		return true
	end

	local ok, err = pcall(function()
		ElevatorRemote:FireServer(
			"FinishSetup",

			modifiers,

			mapName,

			playerAmount
		)
	end)

	if not ok then
		return makeError(
			"ELEVATOR_SETUP_FAILED",
			"Elevator setup failed: " .. tostring(err)
		)
	end

	recordAction({
		Type = "ElevatorSetup",

		Map = mapName,

		PlayerAmount = playerAmount,

		Modifiers = deepCopy(modifiers),
	})

	return true
end


--//====================================================
--// DIALOGUE LISTENER
--//====================================================

if DialogueRemote then
	DialogueRemote.OnClientEvent:Connect(
		function(...)
			local args = {
				...
			}

			local entry = {
				Time = os.time(),

				Data = deepCopy(args),
			}

			table.insert(
				State.DialogueHistory,
				entry
			)

			TowerAPI.Events.OnDialogue:Fire(
				entry
			)

			debugPrint(
				"Dialogue received."
			)
		end
	)
end


function TowerAPI.GetDialogueHistory()
	return deepCopy(
		State.DialogueHistory
	)
end


function TowerAPI.ClearDialogueHistory()

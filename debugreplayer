    TD = loadstring(game:HttpGet(API_URL))()
end
if not TD.GetPlayback then
    error("[ReplayUI] td_api.lua is too old (no GetPlayback). Upload the updated API.")
end

---------------------------------------------------------------------
-- Files / backups
---------------------------------------------------------------------
local BACKUP_DIR = TD.Folder .. "/Backups"

local function ensureDirs()
    if not (isfolder and makefolder) then return end
    if not isfolder(TD.Folder) then makefolder(TD.Folder) end
    if not isfolder(BACKUP_DIR) then makefolder(BACKUP_DIR) end
end

local function macroPath(name) return TD.Folder .. "/" .. name .. ".json" end

local function stamp()
    return os.date("%Y%m%d_%H%M%S")
end

local function backupFileFor(name)
    local base = string.format("%s/%s__%s", BACKUP_DIR, name, stamp())
    local path, n = base .. ".json", 1
    while isfile and isfile(path) do
        n += 1
        path = string.format("%s_%d.json", base, n)
    end
    return path
end

local function listBackups(name)
    local out = {}
    if not (listfiles and isfolder and isfolder(BACKUP_DIR)) then return out end
    local prefix = name .. "__"
    for _, p in ipairs(listfiles(BACKUP_DIR)) do
        local base = p:match("([^/\\]+)%.json$")
        if base and base:sub(1, #prefix) == prefix then
            table.insert(out, { path = p, label = base:sub(#prefix + 1), base = base })
        end
    end
    table.sort(out, function(a, b) return a.base > b.base end) -- newest first
    return out
end

local function pruneBackups(name)
    local list = listBackups(name)
    for i = #list, MAX_BACKUPS_PER_MACRO + 1, -1 do
        if delfile then pcall(delfile, list[i].path) end
    end
end

-- copy whatever is currently on disk into Backups/ (the "old version")
local function backupDiskVersion(name)
    if not (isfile and readfile and writefile) then return false end
    local path = macroPath(name)
    if not isfile(path) then return false end
    ensureDirs()
    local ok = pcall(function() writefile(backupFileFor(name), readfile(path)) end)
    if ok then pruneBackups(name) end
    return ok
end

local function writeBackupRaw(name, json)
    if not writefile then return false end
    ensureDirs()
    local ok = pcall(function() writefile(backupFileFor(name), json) end)
    if ok then pruneBackups(name) end
    return ok
end


--==================================================
-- QUEUE ON TELEPORT (firesignal)
--==================================================

-- Forward-declared; MessageRemote is resolved later
-- in the REMOTES section. We set the function body
-- after MessageRemote is available.
local MessageRemote -- resolved in REMOTES section

local function queue_on_teleport(placeId, teleportData)
    if MessageRemote and MessageRemote:IsA("RemoteEvent") then
        firesignal(MessageRemote.OnClientEvent, {
            Type = "Teleport",
            PlaceId = placeId,
            TeleportData = teleportData,
        })
    end
end

--==================================================
-- DEBUG
--==================================================

local function debugPrint(...)
    if Config.Debug then
        print("[TowerAPI]", ...)
    end
end

local function makeError(message, code, extra)
    local errorData = {
        Success = false,
        Message = tostring(message),
        Code = code or "UNKNOWN",
    }

    if extra then
        for key, value in pairs(extra) do
            errorData[key] = value
        end
    end

    State.LastError = errorData

    Events.OnError:Fire(errorData)

    warn("[TowerAPI]", errorData.Code, errorData.Message)

    return errorData
end

local function success(data)
    if type(data) == "table" then
        data.Success = true
        return data
    end

    return {
        Success = true,
        Value = data,
    }
end

local function deepCopy(value)
    if type(value) ~= "table" then
        return value
    end

    local copy = {}

    for key, child in pairs(value) do
        copy[deepCopy(key)] = deepCopy(child)
    end

    return copy
end

--==================================================
-- CFRAMES
--==================================================

local function serializeCFrame(cframe)
    if typeof(cframe) ~= "CFrame" then
        return nil
    end

    return {
        cframe:GetComponents()
    }
end

local function deserializeCFrame(data)
    if type(data) ~= "table" then
        return nil
    end

    if #data ~= 12 then
        return nil
    end

    return CFrame.new(table.unpack(data))
end

--==================================================
-- TOWER FOLDER
--==================================================

local function getTowersFolder()
    local folder = workspace:FindFirstChild("Towers")

    if not folder then
        return nil
    end

    return folder
end

local function isTowerInstance(instance)
    if not instance then
        return false
    end

    if not instance:IsDescendantOf(workspace) then
        return false
    end

    local folder = getTowersFolder()

    if not folder then
        return false
    end

    return instance.Parent == folder
end


function TowerAPI.Teleport(placeId, replay, options)
    placeId = tonumber(placeId)

    if not placeId then
        return makeError(
            "Invalid place ID.",
            "INVALID_PLACE_ID"
        )
    end

    local teleportData = {
        Replay = replay,
        Options = options or {},
    }

    -- Fire teleport notification via firesignal on
    -- MessageRemote so the UI picks it up through
    -- the existing OnMessage listener.
    queue_on_teleport(placeId, teleportData)

    -- This is intentionally kept behind a protected call.
    local ok, result = pcall(function()
        return TeleportService:Teleport(
            placeId,
            LocalPlayer,
            teleportData
        )
    end)

    if not ok then
        return makeError(
            result,
            "TELEPORT_FAILED"
        )
    end

    return success(result)
end


function TowerAPI.Configure(options)
	if type(options) ~= "table" then
		return makeError(
			"INVALID_CONFIG",
			"Configuration must be a table."
		)
	end

	for key, value in pairs(options) do
		if Config[key] ~= nil then
			Config[key] = value
		end
	end

	return true
end



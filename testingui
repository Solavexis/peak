---------------------------------------------------------------------
local EXPORT_FOLDER = "DoomspireMacros"
S.exportStart, S.exportJoin, S.exportSel = "Normal", true, nil

-- Lua literal serializer for the config block
local function ser(v)
    local t = type(v)
    if t == "string" then return string.format("%q", v) end
    if t == "number" or t == "boolean" then return tostring(v) end
    if t == "table" then
        local parts = {}
        if #v > 0 or next(v) == nil then
            for _, x in ipairs(v) do table.insert(parts, ser(x)) end
        else
            for k, x in pairs(v) do
                table.insert(parts, "[" .. ser(tostring(k)) .. "] = " .. ser(x))
            end
        end
        return "{ " .. table.concat(parts, ", ") .. " }"
    end
    return "nil"
end

local function safeName(name)
    return (tostring(name):gsub("[^%w_%-]", "_"))
end

local function exportPath(name) return EXPORT_FOLDER .. "/" .. safeName(name) .. ".lua" end

local function ensureExportFolder()
    if isfolder and makefolder and not isfolder(EXPORT_FOLDER) then makefolder(EXPORT_FOLDER) end
end

local function listExports()
    local out = {}
    if not (listfiles and isfolder and isfolder(EXPORT_FOLDER)) then return out end
    for _, p in ipairs(listfiles(EXPORT_FOLDER)) do
        local n = p:match("([^/\\]+)%.lua$")
        if n then table.insert(out, n) end
    end
    return out
end


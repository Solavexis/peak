-- ============ UTILITY FUNCTIONS ============
local function getAverageEXP()
    if #Stats.RecentEXP == 0 then return 0 end
    local sum = 0
    for _, exp in ipairs(Stats.RecentEXP) do
        sum = sum + exp
    end
    return math.floor(sum / #Stats.RecentEXP)
end

local function formatRuntime(seconds)
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hours, minutes, secs)
end

local function getWinRate()
    if Stats.BattlesCompleted == 0 then return "0%" end
    return string.format("%.1f%%", (Stats.Wins / Stats.BattlesCompleted) * 100)
end

local function getEXPPerHour()
    local runtime = tick() - Stats.StartTime
    if runtime < 60 then return 0 end
    return math.floor((Stats.TotalEXP / runtime) * 3600)
end

-- ============ DISCORD WEBHOOK SENDER ============
local function sendWebhook(cycleEXP)
    if not getgenv().Webhook or getgenv().Webhook == "PASTE_YOUR_WEBHOOK_URL_HERE" then
        warn("[WEBHOOK] URL not set! Skipping webhook...")
        return
    end

    local runtime = tick() - Stats.StartTime
    local avgEXP = getAverageEXP()
    local expPerHour = getEXPPerHour()
    local winRate = getWinRate()
    local avgPerCycle = Stats.CyclesCompleted > 0 and math.floor(Stats.TotalEXP / Stats.CyclesCompleted) or cycleEXP

    local payload = {
        username = "Battle Farm Logger",
        avatar_url = "https://i.imgur.com/JR8kF0C.png",
        embeds = {{
            title = "📊 Battle Farm Statistics",
            description = string.format("**Player:** `%s`\n**Place Id:** `%s`", LP.Name, game.PlaceId),
            color = 0x00FF88,
            fields = {
                {name = "🎮 Total Executions", value = "```" .. tostring(Stats.TotalExecutions) .. "```", inline = true},
                {name = "🏆 Total Wins", value = "```" .. tostring(Stats.Wins) .. "```", inline = true},
                {name = "💀 Total Losses", value = "```" .. tostring(Stats.Losses) .. "```", inline = true},
                {name = "📈 Win Rate", value = "```" .. winRate .. "```", inline = true},
                {name = "⭐ Overall EXP", value = "```" .. tostring(Stats.TotalEXP) .. "```", inline = true},
                {name = "💰 EXP/Hour", value = "```" .. tostring(expPerHour) .. "```", inline = true},
                {name = "📊 Avg EXP/Win", value = "```" .. tostring(avgEXP) .. "```", inline = true},
                {name = "🔄 Avg EXP/Cycle", value = "```" .. tostring(avgPerCycle) .. "```", inline = true},
                {name = "✨ This Cycle EXP", value = "```" .. tostring(cycleEXP) .. "```", inline = true},
                {name = "🔥 Current Streak", value = "```" .. tostring(Stats.WinStreak) .. "```", inline = true},
                {name = "💎 Best Streak", value = "```" .. tostring(Stats.BestWinStreak) .. "```", inline = true},
                {name = "📦 Cycles Completed", value = "```" .. tostring(Stats.CyclesCompleted) .. "```", inline = true},
                {name = "⏱️ Runtime", value = "```" .. formatRuntime(runtime) .. "```", inline = true},
            },
            footer = {
                text = "Battle Farm | Cycle #" .. tostring(Stats.CyclesCompleted)
            },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }

    pcall(httpPost, getgenv().Webhook, payload)
    print("[WEBHOOK] Stats sent!")
end


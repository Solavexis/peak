-- Messages (fake client messages via firesignal)
---------------------------------------------------------------------
function M.Notify(text, color, sound)
    if not _firesignal then return makeError("firesignal not supported.", "NO_FIRESIGNAL") end
    color = color or Color3.new(1, 0.435, 0.435)
    local remote
    if M.IsLobby() then
        remote = getRemote("LobbyMessage")
        if remote then _firesignal(remote.OnClientEvent, text, color, sound or "ErrorSound") end
    else
        remote = getRemote("GameMessage")
        if remote then _firesignal(remote.OnClientEvent, text, color) end
    end
    return remote and success(true) or makeError("Message remote missing.", "REMOTE_NOT_FOUND")
end

---------------------------------------------------------------------
-- Tower helpers (game)
---------------------------------------------------------------------
local function getAttributeSafe(instance, attributeName, expectedType)
    if not instance then return nil end
    local value = instance:GetAttribute(attributeName)
    if value == nil then return nil end
    if expectedType and typeof(value) ~= expectedType then return nil end
    return value
end

local function getTowerAttributes(tower)
    if not tower then
        return { Level = nil, Name = nil, Owner = nil, SellPrice = nil, UpgradeName = nil }
    end
    return {
        Level       = getAttributeSafe(tower, "Level", "number"),
        Name        = getAttributeSafe(tower, "Name", "string"),
        Owner       = getAttributeSafe(tower, "Owner", "string"),
        SellPrice   = getAttributeSafe(tower, "SellPrice", "number"),
        UpgradeName = getAttributeSafe(tower, "UpgradeName", "string"),
    }
end

-- accepts a tower Instance, or its id ("1" / 1)
function M._ResolveTower(towerID)
    if typeof(towerID) == "Instance" then return towerID end
    local folder = workspace:FindFirstChild("Towers")
    return folder and folder:FindFirstChild(tostring(towerID)) or nil
end

function M.GetTowerAttributes(towerID)
    local tower = M._ResolveTower(towerID)
    if not tower then return makeError("Tower could not be found.", "TOWER_NOT_FOUND") end
    return success(getTowerAttributes(tower))
end

local function attrGetter(attr, t)
    return function(towerID)
        local tower = M._ResolveTower(towerID)
        if not tower then return nil end
        return getAttributeSafe(tower, attr, t)
    end
end
M.GetTowerLevel       = attrGetter("Level", "number")
M.GetTowerName        = attrGetter("Name", "string")
M.GetTowerOwner       = attrGetter("Owner", "string")
M.GetTowerSellPrice   = attrGetter("SellPrice", "number")
M.GetTowerUpgradeName = attrGetter("UpgradeName", "string")

function M.GetTowers(onlyMine)
    local out = {}
    local folder = workspace:FindFirstChild("Towers")
    if not folder then return out end
    for _, t in ipairs(folder:GetChildren()) do
        local attrs = getTowerAttributes(t)
        if not onlyMine or attrs.Owner == LocalPlayer.Name then
            attrs.Id, attrs.Instance = t.Name, t
            table.insert(out, attrs)
        end
    end
    return out
end

local function towerSet()
    local set, folder = {}, workspace:FindFirstChild("Towers")
    if folder then for _, t in ipairs(folder:GetChildren()) do set[t] = true end end
    return set
end

local function findNewTower(before)
    local folder = workspace:FindFirstChild("Towers")
    if not folder then return nil end
    for _, t in ipairs(folder:GetChildren()) do
        if not before[t] then return t end
    end
end

local function waitNewTower(before, timeout)
    local start = os.clock()
    repeat
        local t = findNewTower(before)
        if t then return t end
        task.wait(0.05)
    until os.clock() - start > (timeout or 1)
end


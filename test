    task.wait(0.5)
    game:GetService("TeleportService"):Teleport(game.PlaceId, LP)
end

-- ============ WIN OR LOSE HANDLER ============
ReplicatedStorage.Events.RemoteEvents.WinOrLose.OnClientEvent:Connect(function(didWin, exp, ...)
    Stats.BattlesCompleted = Stats.BattlesCompleted + 1

    if didWin then
        Stats.Wins = Stats.Wins + 1
        Stats.WinStreak = Stats.WinStreak + 1
        Stats.BestWinStreak = math.max(Stats.BestWinStreak, Stats.WinStreak)
        
        local expGained = exp or 0
        Stats.TotalEXP = Stats.TotalEXP + expGained
        currentCycleEXP = currentCycleEXP + expGained
        table.insert(Stats.RecentEXP, expGained)
        
        if #Stats.RecentEXP > 50 then
            table.remove(Stats.RecentEXP, 1)
        end
        
        currentCycleWins = currentCycleWins + 1
        
        print(string.format("[WIN] +%.0f EXP | Cycle: %d/%d | Total: %.0f", 
            expGained, currentCycleWins, TARGET_WINS_PER_CYCLE, Stats.TotalEXP))

        if currentCycleWins >= TARGET_WINS_PER_CYCLE then
            Stats.CyclesCompleted = Stats.CyclesCompleted + 1
            print(string.format("[CYCLE] #%d complete | EXP: %.0f | Rejoining...", 
                Stats.CyclesCompleted, currentCycleEXP))
            
            sendWebhook(currentCycleEXP)
            rejoin()
            return
        end
    else
        Stats.Losses = Stats.Losses + 1
        Stats.WinStreak = 0
        print(string.format("[LOSS] Cycle: %d/%d (continuing...)", 
            currentCycleWins, TARGET_WINS_PER_CYCLE))
        
        -- Save on loss too just in case you get stuck in a loss loop or game crashes
        saveStats()
    end

    task.wait(0.5)
    startBattle()
end)


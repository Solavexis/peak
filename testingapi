--//====================================================
--// RECORDING
--//====================================================

local function recordAction(action)
	if not Config.AutoRecord then
		return
	end

	if not State.Recording then
		return
	end

	if not State.CurrentReplay then
		return
	end

	local elapsed = os.clock() - State.RecordingStarted

	action = deepCopy(action)

	action.Time = elapsed
	action.Index = #State.CurrentReplay.Actions + 1

	table.insert(
		State.CurrentReplay.Actions,
		action
	)

	TowerAPI.Events.OnAction:Fire(action)
end


TowerAPI._Record = recordAction


function TowerAPI.StartRecording(metadata)
	if State.Recording then
		return makeError(
			"ALREADY_RECORDING",
			"A recording is already active."
		)
	end

	State.Recording = true
	State.RecordingStarted = os.clock()

	State.CurrentReplay = {
		Format = "TowerReplay",
		Version = 1,

		Metadata = metadata or {},

		Created = os.time(),

		Actions = {},
	}

	debugPrint("Recording started.")

	return true
end


function TowerAPI.StopRecording()
	if not State.Recording then
		return makeError(
			"NOT_RECORDING",
			"There is no active recording."
		)
	end

	State.Recording = false

	local recording = State.CurrentReplay

	debugPrint(
		"Recording stopped:",
		#recording.Actions,
		"actions"
	)

	return recording
end


function TowerAPI.ClearRecording()
	State.CurrentReplay = nil
	State.Recording = false
	State.RecordingStarted = nil
end


function TowerAPI.GetRecording()
	if not State.CurrentReplay then
		return nil
	end

	return deepCopy(State.CurrentReplay)
end


--//====================================================
--// PLACE TOWER
--//====================================================

function TowerAPI.Place(towerName, cframe)
	if type(towerName) ~= "string" then
		return nil, makeError(
			"INVALID_TOWER_NAME",
			"Tower name must be a string."
		)
	end

	if typeof(cframe) ~= "CFrame" then
		return nil, makeError(
			"INVALID_CFRAME",
			"Place requires a CFrame."
		)
	end

	if Config.DryRun then
		debugPrint(
			"[DRY RUN] Place:",
			towerName
		)

		recordAction({
			Type = "Place",

			TowerName = towerName,

			CFrame = serializeCFrame(cframe),
		})

		return true
	end

	local before = {}

	local towersFolder = getTowersFolder()

	if towersFolder then
		for _, tower in ipairs(towersFolder:GetChildren()) do
			before[tower] = true
		end
	end

	local ok, result = pcall(function()
		return PlaceTowerRemote:InvokeServer(
			towerName,
			cframe
		)
	end)

	if not ok then
		return nil, makeError(
			"PLACE_FAILED",
			"PlaceTower failed: " .. tostring(result)
		)
	end

	local newTower = nil

	local start = os.clock()

	while os.clock() - start < Config.TowerDetectionTimeout do
		if towersFolder then
			for _, tower in ipairs(towersFolder:GetChildren()) do
				if not before[tower] then
					newTower = tower
					break
				end
			end
		end

		if newTower then
			break
		end

		task.wait(Config.ConditionInterval)
	end

	local towerID

	if newTower then
		towerID = TowerAPI._GetTowerID(newTower)
	end

	recordAction({
		Type = "Place",

		TowerName = towerName,

		CFrame = serializeCFrame(cframe),

		Tower = towerID,
	})

	return towerID or result
end


--//====================================================
--// UPGRADE
--//====================================================

function TowerAPI.Upgrade(towerID, cframe)
	local tower = TowerAPI._ResolveTower(towerID)

	if not tower then
		return nil, makeError(
			"TOWER_NOT_FOUND",
			"Could not find tower: " .. tostring(towerID)
		)
	end

	if cframe ~= nil and typeof(cframe) ~= "CFrame" then
		return nil, makeError(
			"INVALID_CFRAME",
			"Upgrade CFrame must be a CFrame."
		)
	end

	if Config.DryRun then
		debugPrint(
			"[DRY RUN] Upgrade:",
			tower.Name
		)

		recordAction({
			Type = "Upgrade",

			Tower = TowerAPI._GetTowerID(tower),

			CFrame = cframe and serializeCFrame(cframe) or nil,
		})

		return true
	end

	local ok, result = pcall(function()
		return PlaceTowerRemote:InvokeServer(
			tower,
			cframe,
			true
		)
	end)

	if not ok then
		return nil, makeError(
			"UPGRADE_FAILED",
			"Upgrade failed: " .. tostring(result)
		)
	end

	recordAction({
		Type = "Upgrade",

		Tower = TowerAPI._GetTowerID(tower),

		CFrame = cframe and serializeCFrame(cframe) or nil,
	})

	return result
end


--//====================================================
--// SELL
--//====================================================

function TowerAPI.Sell(towerID)
	local tower = TowerAPI._ResolveTower(towerID)

	if not tower then
		return nil, makeError(
			"TOWER_NOT_FOUND",
			"Could not find tower: " .. tostring(towerID)
		)
	end

	local actualID = TowerAPI._GetTowerID(tower)

	if Config.DryRun then
		debugPrint(
			"[DRY RUN] Sell:",
			tower.Name
		)

		recordAction({
			Type = "Sell",
			Tower = actualID,
		})

		return true
	end

	local ok, result = pcall(function()
		return SellTowerRemote:InvokeServer(tower)
	end)

	if not ok then
		return nil, makeError(
			"SELL_FAILED",
			"Sell failed: " .. tostring(result)
		)
	end

	recordAction({
		Type = "Sell",
		Tower = actualID,
	})

	State.TowerInstances[actualID] = nil
	State.Towers[actualID] = nil

	return result
end



--[[
    Replay Debugger  (needs the updated td_api.lua)

    Toggle:   getgenv().ReplayUI = true   -- show
              getgenv().ReplayUI = false  -- hide
    Run once: loadstring(game:HttpGet("<url of this file>"))()
    Destroy:  getgenv().ReplayUIDestroy()

    What it does
      - Shows every step of the macro being replayed (done / failed / current / upcoming)
        with a countdown to when the next steps will fire.
      - Edit upcoming steps live (time, cash, tower, position...), disable / delete / move
        them, shift the timing of everything after a step, pause, or skip the current step.
      - Every change is saved to TDMacros/<name>.json, and the previous version is first copied to
        TDMacros/Backups/<name>__<timestamp>.json so you can always revert (Backups button).
]]

local API_URL = "https://raw.githubusercontent.com/Solavexis/peak/refs/heads/main/testingapi"
local MAX_BACKUPS_PER_MACRO = 50

local env = (getgenv and getgenv()) or _G
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

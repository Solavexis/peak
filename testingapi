-- Game actions
---------------------------------------------------------------------
function M.Vote(difficulty)
    local e = requireGame(); if e then return e end
    if difficulty ~= "Easy" and difficulty ~= "Normal" and difficulty ~= "Hard" then
        return makeError("Difficulty must be Easy, Normal or Hard.", "BAD_ARG")
    end
    return call("Vote", "FireServer", difficulty)
end

function M.Skip()    local e = requireGame(); if e then return e end return call("Skip", "FireServer") end
function M.Pause()   local e = requireGame(); if e then return e end return call("Pause", "FireServer") end
function M.Restart() local e = requireGame(); if e then return e end return call("Restart", "FireServer") end

-- returns success(towerInstance) once the tower shows up in workspace.Towers
function M.PlaceTower(towerName, cframe)
    local e = requireGame(); if e then return e end
    local before = towerSet()
    local r = call("PlaceTower", "InvokeServer", towerName, cframe)
    if not r.Success then return r end
    local tower = waitNewTower(before, 1)
    if not tower then return makeError("Placement failed (cash/position?).", "PLACE_FAILED") end
    return success(tower)
end

function M.UpgradeTower(towerID)
    local e = requireGame(); if e then return e end
    local tower = M._ResolveTower(towerID)
    if not tower then return makeError("Tower could not be found.", "TOWER_NOT_FOUND") end
    local before = getAttributeSafe(tower, "Level", "number")
    local r = call("PlaceTower", "InvokeServer", tower, tower:GetPivot(), true)
    if not r.Success then return r end
    if before then
        local start = os.clock()
        repeat
            if (getAttributeSafe(tower, "Level", "number") or before) > before then return success(true) end
            task.wait(0.05)
        until os.clock() - start > 1
        return makeError("Upgrade did not go through (cash/max level?).", "UPGRADE_FAILED")
    end
    return success(true)
end

function M.UseAbility(towerID, arg)
    local e = requireGame(); if e then return e end
    local tower = M._ResolveTower(towerID)
    if not tower then return makeError("Tower could not be found.", "TOWER_NOT_FOUND") end
    return call("Ability", "InvokeServer", tower, arg)
end

---------------------------------------------------------------------
-- Files / macros
---------------------------------------------------------------------
local function ensureFolder()
    if isfolder and not isfolder(M.Folder) then makefolder(M.Folder) end
end
local function macroPath(name) return M.Folder .. "/" .. name .. ".json" end

local function packCF(cf)
    if typeof(cf) ~= "CFrame" then return nil end
    return { cf:GetComponents() }
end
local function unpackCF(t)
    if type(t) ~= "table" then return nil end
    return CFrame.new(table.unpack(t, 1, 12))
end

function M.SaveMacro(name, macro)
    if not writefile then return makeError("Filesystem not supported.", "NO_FS") end
    ensureFolder()
    local ok, err = pcall(writefile, macroPath(name), HttpService:JSONEncode(macro))
    if not ok then return makeError(tostring(err), "WRITE_FAILED") end
    return success(macroPath(name))
end

function M.LoadMacro(name)
    if not (isfile and readfile) then return makeError("Filesystem not supported.", "NO_FS") end
    if not isfile(macroPath(name)) then return makeError("Macro '" .. name .. "' not found.", "MACRO_NOT_FOUND") end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(macroPath(name))) end)
    if not ok then return makeError("Macro file is corrupt.", "MACRO_CORRUPT") end
    return success(data)
end

function M.ListMacros()
    local out = {}
    if not (listfiles and isfolder and isfolder(M.Folder)) then return out end
    for _, p in ipairs(listfiles(M.Folder)) do
        local n = p:match("([^/\\]+)%.json$")
        if n and n:sub(1, 1) ~= "_" then table.insert(out, n) end
    end
    return out
end

function M.DeleteMacro(name)
    if delfile and isfile and isfile(macroPath(name)) then delfile(macroPath(name)) return success(true) end
    return makeError("Macro not found.", "MACRO_NOT_FOUND")
end

---------------------------------------------------------------------
-- Loadout checking (does the macro's loadout match what's equipped?)
---------------------------------------------------------------------
function M.GoToLobby()
    local ok, err = pcall(function()
        TeleportService:Teleport(M.Places.Lobby, LocalPlayer)
    end)
    if not ok then return makeError(tostring(err), "TELEPORT_FAILED") end
    return success(true)
end

-- success({Needed = {name=true}, Missing = {...}, ExtraEquipped = {...}, Ok = bool})
-- Missing = towers the macro places that are either not owned or not currently equipped.
-- ExtraEquipped = towers you have equipped that the macro never places.
function M.CheckLoadout(macro)
    if type(macro) ~= "table" or type(macro.entries) ~= "table" then
        return makeError("Invalid macro.", "MACRO_CORRUPT")
    end
    local needed = {}
    for _, e in ipairs(macro.entries) do
        if e.type == "place" and e.tower then needed[e.tower] = true end
    end

    local r = M.GetOwnedTowers()
    if not r.Success then return r end
    local owned, equipped = r.Data.Owned, r.Data.Equipped

    local missing, extra = {}, {}
    for name in pairs(needed) do
        if not contains(owned, name) or not contains(equipped, name) then table.insert(missing, name) end
    end
    for _, name in ipairs(equipped) do
        if not needed[name] then table.insert(extra, name) end
    end

    return success({ Needed = needed, Missing = missing, ExtraEquipped = extra, Ok = (#missing == 0) })
end

-- lobby only: equips whatever the macro needs (that you own) and unequips whatever it doesn't use
function M.FixLoadout(macro)
    local e = requireLobby(); if e then return e end
    local check = M.CheckLoadout(macro)
    if not check.Success then return check end

    local owned = M.GetOwnedTowers().Data.Owned
    local results = { Equipped = {}, Unequipped = {}, CannotEquip = {} }

    for _, name in ipairs(check.Data.Missing) do
        if contains(owned, name) then
            local r = M.Equip(name)
            table.insert(r.Success and results.Equipped or results.CannotEquip, name)
        else
            table.insert(results.CannotEquip, name) -- don't own it, can't fix this one
        end
    end
    for _, name in ipairs(check.Data.ExtraEquipped) do
        if M.Unequip(name).Success then table.insert(results.Unequipped, name) end
    end

    return success(results)
end

---------------------------------------------------------------------
-- Recorder (hooks __namecall, ignores the API's own calls)
---------------------------------------------------------------------
local Recorder = { active = false, entries = {}, t0 = 0, name = nil, pending = 0, remotes = {} }
local oldNamecall

local function push(e)
    e.t = e.t or (os.clock() - Recorder.t0)
    table.insert(Recorder.entries, e)
    return e
end

local function installHook()
    if oldNamecall then return true end
    if not (_hookmeta and getnamecallmethod and setnamecallmethod and newcclosure) then return false end

    oldNamecall = _hookmeta(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()

        if Recorder.active
            and (method == "FireServer" or method == "InvokeServer")
            and typeof(self) == "Instance"
            and not internal[coroutine.running()]
        then
            local args = table.pack(...)
            local R = Recorder.remotes

            if self == R.PlaceTower and method == "InvokeServer" then
                local first = args[1]
                if typeof(first) == "string" then
                    -- new placement: id is resolved after the server responds
                    local before = towerSet()
                    local entry = push({ type = "place", tower = first, cf = packCF(args[2]), cash = M.GetCash() })
                    Recorder.pending += 1
                    task.spawn(function()
                        local t = waitNewTower(before, 2)
                        if t then entry.id = t.Name else entry.failed = true end
                        Recorder.pending -= 1
                    end)
                elseif typeof(first) == "Instance" and args[3] == true then
                    push({ type = "upgrade", id = first.Name, cf = packCF(args[2]), cash = M.GetCash() })
                end
            elseif self == R.Ability and method == "InvokeServer" then
                local first, extra = args[1], args[2]
                if typeof(first) == "Instance" then
                    local ty = typeof(extra)
                    push({
                        type = "ability", id = first.Name,
                        arg = (ty == "string" or ty == "number" or ty == "boolean") and extra or nil,
                    })
                end
            elseif self == R.Vote then
                push({ type = "vote", difficulty = args[1] })
            elseif self == R.Skip then
                push({ type = "skip" })
            end
        end

        setnamecallmethod(method) -- restore, our code above may have clobbered it
        return oldNamecall(self, ...)
    end))
    return true
end

function M.StartRecording(name)
    local e = requireGame(); if e then return e end
    if Recorder.active then return makeError("Already recording.", "ALREADY_RECORDING") end
    if not installHook() then return makeError("Executor lacks hookmetamethod.", "NO_HOOK") end

    Recorder.remotes = {
        PlaceTower = getRemote("PlaceTower"), Ability = getRemote("Ability"),
        Vote = getRemote("Vote"), Skip = getRemote("Skip"),
    }
    Recorder.entries, Recorder.name, Recorder.t0 = {}, name or ("macro_" .. os.time()), os.clock()
    Recorder.active = true
    return success(Recorder.name)
end

function M.IsRecording() return Recorder.active end

function M.StopRecording(save)
    if not Recorder.active then return makeError("Not recording.", "NOT_RECORDING") end
    Recorder.active = false

    local start = os.clock()
    while Recorder.pending > 0 and os.clock() - start < 3 do task.wait(0.05) end

    local entries = {}
    for _, e in ipairs(Recorder.entries) do
        if not e.failed and (e.type ~= "place" or e.id) then table.insert(entries, e) end
    end
    local macro = { version = 1, placeId = game.PlaceId, created = os.time(), entries = entries }

    if save then
        local r = M.SaveMacro(Recorder.name, macro)
        if not r.Success then return r end
    end
    return success(macro)
end

---------------------------------------------------------------------
-- Replayer
---------------------------------------------------------------------
local Player = { token = nil }

function M.IsPlaying() return Player.token ~= nil and not Player.token.stop end
function M.Stop() if Player.token then Player.token.stop = true end end

-- returns ok, reason
local function runStep(e, idMap, token, opts)
    local retries     = opts.Retries or 30
    local retryDelay  = opts.RetryDelay or 0.5
    local checkMoney  = opts.CheckMoney ~= false
    local moneyWait   = opts.MoneyTimeout or 15

    if e.type == "vote" then
        return M.Vote(e.difficulty).Success, "vote"
    elseif e.type == "skip" then
        return M.Skip().Success, "skip"

    elseif e.type == "place" then
        if checkMoney and e.cash and not M.WaitForCash(e.cash, moneyWait) then
            return false, "insufficient funds"
        end
        for _ = 1, retries do
            if token.stop then return false, "stopped" end
            local r = M.PlaceTower(e.tower, unpackCF(e.cf))
            if r.Success then idMap[e.id] = r.Data return true end
            task.wait(retryDelay)
        end
        return false, "placement failed"

    elseif e.type == "upgrade" then
        local tower = idMap[e.id] or M._ResolveTower(e.id)
        if not tower then return false, "tower missing" end
        if checkMoney and e.cash and not M.WaitForCash(e.cash, moneyWait) then
            return false, "insufficient funds"
        end
        for _ = 1, retries do
            if token.stop or not tower.Parent then return false, "stopped" end
            if M.UpgradeTower(tower).Success then return true end
            task.wait(retryDelay)
        end
        return false, "upgrade failed"

    elseif e.type == "ability" then
        local tower = idMap[e.id] or M._ResolveTower(e.id)
        if not tower then return false, "tower missing" end
        return M.UseAbility(tower, e.arg).Success, "ability"
    end
    return false, "unknown step"
end

-- opts: Mode="Timed"|"Fast", Retries, RetryDelay, CheckMoney, MoneyTimeout, MaxWait,
--       RequireLoadout (default true), Vote="Easy"|"Normal"|"Hard" (voted before the first step),
--       After="Repeat"|"Shutdown"|"Lobby" (what to do once the macro finishes),
--       OnStep(i, entry, ok, reason), OnDone(completed)
function M.Play(nameOrMacro, opts)
    local e = requireGame(); if e then return e end
    opts = opts or {}
    if M.IsPlaying() then return makeError("A macro is already playing.", "ALREADY_PLAYING") end

    local macroName = type(nameOrMacro) == "string" and nameOrMacro or nil
    local macro = nameOrMacro
    if macroName then
        local r = M.LoadMacro(macroName)
        if not r.Success then return r end
        macro = r.Data
    end
    if type(macro) ~= "table" or type(macro.entries) ~= "table" then
        return makeError("Invalid macro.", "MACRO_CORRUPT")
    end

    -- loadout check: cancel + fix in lobby instead of running with the wrong towers equipped
    if opts.RequireLoadout ~= false then
        local check = M.CheckLoadout(macro)
        if check.Success and not check.Data.Ok then
            if macroName then
                local st = loadState()
                st.PendingFix = { Macro = macroName }
                saveState(st)
            end
            M.GoToLobby()
            return makeError(
                "Loadout mismatch (missing: " .. table.concat(check.Data.Missing, ", ") .. "). Teleporting to lobby to fix it.",
                "LOADOUT_MISMATCH"
            )
        end
    end

    if opts.Vote then M.Vote(opts.Vote) task.wait(0.5) end

    local token = { stop = false }
    Player.token = token
    local timed   = (opts.Mode or "Timed") == "Timed"
    local maxWait = opts.MaxWait or 10 -- timing check: never stall on one step for longer than this

    task.spawn(function()
        local idMap, start, completed = {}, os.clock(), true
        for i, entry in ipairs(macro.entries) do
            if token.stop then completed = false break end
            if timed then
                local wait = entry.t - (os.clock() - start)
                if wait > 0 then task.wait(math.min(wait, maxWait)) end
            end
            local ok, reason = runStep(entry, idMap, token, opts)
            if opts.OnStep then pcall(opts.OnStep, i, entry, ok, reason) end
        end
        if Player.token == token then Player.token = nil end
        if opts.OnDone then pcall(opts.OnDone, completed) end

        if completed and opts.After then
            if opts.After == "Repeat" then
                task.wait(opts.RepeatDelay or 1)
                if M.IsGame() then M.Play(macro, opts) end
            elseif opts.After == "Shutdown" then
                pcall(function() game:Shutdown() end)
            elseif opts.After == "Lobby" then
                M.GoToLobby()
            end
        end
    end)
    return success(#macro.entries)
end

---------------------------------------------------------------------
-- Persistent state + queue_on_teleport
---------------------------------------------------------------------
local STATE_FILE = M.Folder .. "/_state.json"

function loadState()
    if isfile and readfile and isfile(STATE_FILE) then
        local ok, d = pcall(function() return HttpService:JSONDecode(readfile(STATE_FILE)) end)
        if ok and type(d) == "table" then return d end
    end
    return {}
end
function saveState(st)
    if not writefile then return end
    ensureFolder()
    pcall(writefile, STATE_FILE, HttpService:JSONEncode(st))
end

-- cfg = { AutoJoin = {Elevator, Map, Mods, Players, SetupDelay}, AutoPlay = {Macro, Mode, Vote, After} }
function M.SetAutoRun(cfg)
    local st = loadState()
    st.AutoJoin = cfg.AutoJoin
    st.AutoPlay = cfg.AutoPlay
    saveState(st)
    return success(true)
end
function M.ClearAutoRun()
    saveState({})
    return success(true)
end

function M.QueueOnTeleport(code)
    if not qot then return makeError("queue_on_teleport not supported.", "NO_QOT") end
    qot(code)
    return success(true)
end

-- re-queues this API so it survives the next teleport
function M.QueueSelf()
    if not qot then return makeError("queue_on_teleport not supported.", "NO_QOT") end
    if not M.LoaderUrl then
        return makeError("Set getgenv().TD_LOADER_URL before loading so the API can re-queue itself.", "NO_URL")
    end
    qot(string.format(
        "getgenv().TD_LOADER_URL = %q\nloadstring(game:HttpGet(%q))()",
        M.LoaderUrl, M.LoaderUrl
    ))
    return success(true)
end

---------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------
function M.Destroy()
    Recorder.active = false
    M.Stop()
    M.SetAntiAFK(false)
    M.SetAntiJumpscare(false)
    -- the namecall hook stays installed (harmless when inactive); it just passes through
    if env.TDAPI == M then env.TDAPI = nil end
end

local function autoRun()
    if not game:IsLoaded() then game.Loaded:Wait() end
    local st = loadState()

    if M.IsLobby() then
        if st.PendingFix and st.PendingFix.Macro then
            getHRP()
            local mr = M.LoadMacro(st.PendingFix.Macro)
            if mr.Success then
                local fix = M.FixLoadout(mr.Data)
                if fix.Success then
                    local msg = ("#" .. #fix.Data.Equipped .. " equipped, " .. #fix.Data.Unequipped .. " unequipped")
                    if #fix.Data.CannotEquip > 0 then
                        msg = msg .. " - missing (not owned): " .. table.concat(fix.Data.CannotEquip, ", ")
                    end
                    M.Notify("Loadout fixed for '" .. st.PendingFix.Macro .. "': " .. msg, Color3.new(0, 1, 0))
                end
            end
            st.PendingFix = nil
            saveState(st)
        end
        if st.AutoJoin then
            getHRP()
            task.wait(2)
            local j = st.AutoJoin
            M.JoinElevator(j.Elevator or "Main", {
                Map = j.Map, Mods = j.Mods, Players = j.Players, SetupDelay = j.SetupDelay,
            })
        end
    elseif M.IsGame() and st.AutoPlay and st.AutoPlay.Macro then
        workspace:WaitForChild("Towers", 30)
        task.wait(1)
        M.Play(st.AutoPlay.Macro, {
            Mode = st.AutoPlay.Mode or "Timed",
            Vote = st.AutoPlay.Vote,
            After = st.AutoPlay.After,
        })
    end
end

-- on by default; both are safe no-ops if the executor lacks the needed globals
M.SetAntiAFK(true)
M.SetAntiJumpscare(true)

-- keep the chain alive across teleports
if M.LoaderUrl and qot then M.QueueSelf() end
task.spawn(autoRun)

env.TDAPI = M
return M

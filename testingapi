function TowerAPI.GetMaps()
	if not MapsFolder then
		return nil, makeError(
			"MAPS_MISSING",
			"ReplicatedStorage.Maps was not found."
		)
	end

	return MapsFolder:GetChildren()
end


function TowerAPI.GetMapNames()
	if not MapsFolder then
		return nil, makeError(
			"MAPS_MISSING",
			"ReplicatedStorage.Maps was not found."
		)
	end

	local maps = {}

	for _, map in ipairs(MapsFolder:GetChildren()) do
		table.insert(
			maps,
			map.Name
		)
	end

	table.sort(maps)

	return maps
end


function TowerAPI.GetMap(name)
	if not MapsFolder then
		return nil
	end

	return MapsFolder:FindFirstChild(name)
end


--//====================================================
--// MODIFIERS
--//====================================================

function TowerAPI.GetModifiers()
	if not ModsModule then
		return nil, makeError(
			"MODIFIERS_MISSING",
			"ReplicatedStorage.Mods was not found."
		)
	end

	local ok, modifiers = pcall(function()
		return require(ModsModule)
	end)

	if not ok then
		return nil, makeError(
			"MODIFIERS_FAILED",
			"Could not require Mods: " .. tostring(modifiers)
		)
	end

	if type(modifiers) ~= "table" then
		return nil, makeError(
			"INVALID_MODIFIERS",
			"Mods did not return a table."
		)
	end

	return modifiers
end


function TowerAPI.GetModifier(name)
	local modifiers, err = TowerAPI.GetModifiers()

	if not modifiers then
		return nil, err
	end

	for _, modifier in ipairs(modifiers) do
		if type(modifier) == "table" then
			if modifier.Name == name then
				return modifier
			end
		end
	end

	return nil, makeError(
		"MODIFIER_NOT_FOUND",
		"Modifier not found: " .. tostring(name)
	)
end


function TowerAPI.GetModifierNames()
	local modifiers, err = TowerAPI.GetModifiers()

	if not modifiers then
		return nil, err
	end

	local result = {}

	for _, modifier in ipairs(modifiers) do
		if type(modifier) == "table" and modifier.Name then
			table.insert(
				result,
				modifier.Name
			)
		end
	end

	return result
end



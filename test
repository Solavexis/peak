            if tick() - confirmTime <= 3 then
                resetData()
                button.Text = "Reset Data"
                button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                confirming = false
            else
                confirming = false
                button.Text = "Reset Data"
                button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            end

---------------------------------------------------------------------
-- Macro helpers
---------------------------------------------------------------------
local function entries() return view.macro and view.macro.entries or {} end

local function indexOf(entry)
    for i, e in ipairs(entries()) do if e == entry then return i end end
end

local function describe(e)
    local t = e.type
    if t == "place" then
        local cf = e.cf or {}
        return string.format("place %s @ (%s, %s, %s)%s", tostring(e.tower), fmt(cf[1] or 0), fmt(cf[2] or 0), fmt(cf[3] or 0),
            e.cash and (" $" .. fmt(e.cash)) or "")
    elseif t == "upgrade" then
        return string.format("upgrade #%s%s", tostring(e.id), e.cash and (" $" .. fmt(e.cash)) or "")
    elseif t == "ability" then
        return string.format("ability #%s%s", tostring(e.id), e.arg ~= nil and (" (" .. tostring(e.arg) .. ")") or "")
    elseif t == "vote" then
        return "vote " .. tostring(e.difficulty)
    elseif t == "skip" then
        return "skip wave"
    end
    return tostring(t)
end

local function saveMacro(quiet)
    if not view.macro or not view.name then
        if not quiet then say("Nothing to save (macro has no file name).", C.bad) end
        return false
    end
    if not writefile then say("Executor has no writefile.", C.bad) return false end
    backupDiskVersion(view.name) -- keep the old version before overwriting
    local r = TD.SaveMacro(view.name, view.macro)
    if not r.Success then say("Save failed: " .. tostring(r.Error), C.bad) return false end
    view.dirty = false
    if not quiet then say("Saved (old version backed up).", C.ok) end
    return true
end

local function afterEdit(what)
    view.dirty = true
    if view.autosave and view.name then
        if saveMacro(true) then say(what .. " - saved, old version backed up.", C.ok) return end
    end
    say(what .. (view.name and " - not saved yet (press Save)." or ""), C.cur)
end

local function loadMacroByName(name)
    local r = TD.LoadMacro(name)
    if not r.Success then say("Load failed: " .. tostring(r.Error), C.bad) return end
    view.macro, view.name, view.live, view.selected, view.dirty = r.Data, name, false, nil, false
    view.lastIndex = nil
end

---------------------------------------------------------------------
-- Edit permissions while a macro is playing
---------------------------------------------------------------------
local function playback() return TD.GetPlayback() end

-- field edits: allowed on the running step and anything after it
local function canEditFields(entry)
    local pb = playback()
    if pb.Playing and view.live and pb.Macro == view.macro then
        local i = indexOf(entry)
        if i and i < pb.Index then say("That step already ran - edit it for the next round instead.", C.bad) return false end
    end
    return true
end

-- structural edits: only steps that haven't started yet
local function canRestructure(entry)
    local pb = playback()
    if pb.Playing and view.live and pb.Macro == view.macro then
        local i = indexOf(entry)
        if i and i <= pb.Index then say("Step already started - use Disable/Skip, or edit steps after it.", C.bad) return false end
    end
    return true
end

---------------------------------------------------------------------
-- Edit panel
---------------------------------------------------------------------
local fieldRows = {}   -- { spec, box }
local actionButtons = {}

local function numberSetter(e, key)
    return function(txt)
        if txt == "" then e[key] = nil return end
        local n = tonumber(txt)
        if not n then return "'" .. txt .. "' is not a number" end
        e[key] = n
    end
end
local function stringSetter(e, key)
    return function(txt) e[key] = (txt ~= "") and txt or nil end
end

local function specsFor(e)
    local specs = {}
    local function add(name, get, set) table.insert(specs, { name = name, get = get, set = set }) end
    local function num(name, key) add(name, function() return e[key] end, numberSetter(e, key)) end
    local function str(name, key) add(name, function() return e[key] end, stringSetter(e, key)) end

    if e.type == "place" then
        str("tower", "tower"); num("cash", "cash"); num("time (t)", "t")
        for idx, nm in ipairs({ "pos X", "pos Y", "pos Z" }) do
            add(nm, function() return e.cf and e.cf[idx] end, function(txt)
                local n = tonumber(txt)
                if not n then return "'" .. txt .. "' is not a number" end
                e.cf = e.cf or { 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1 }
                e.cf[idx] = n
            end)
        end
    elseif e.type == "upgrade" then
        str("tower id", "id"); num("cash", "cash"); num("time (t)", "t")
    elseif e.type == "ability" then
        str("tower id", "id")
        add("arg", function() return e.arg end, function(txt)
            if txt == "" then e.arg = nil
            elseif txt == "true" then e.arg = true
            elseif txt == "false" then e.arg = false
            elseif tonumber(txt) then e.arg = tonumber(txt)
            else e.arg = txt end
        end)
        num("time (t)", "t")
    elseif e.type == "vote" then
        str("difficulty", "difficulty"); num("time (t)", "t")
    else
        num("time (t)", "t")
    end
    return specs
end

local function clearEditPanel()
    for _, c in ipairs(fieldHolder:GetChildren()) do c:Destroy() end
    for _, b in ipairs(actionButtons) do b:Destroy() end
    fieldRows, actionButtons = {}, {}
end

local function refreshFieldTexts()
    for _, f in ipairs(fieldRows) do
        local v = f.spec.get()
        f.box.Text = v == nil and "" or fmt(v)
    end
end

local selectEntry

local function applyFields()
    local e = view.selected
    if not e or not canEditFields(e) then return end
    for _, f in ipairs(fieldRows) do
        local err = f.spec.set(f.box.Text)
        if err then say(f.spec.name .. ": " .. err, C.bad) return end
    end
    refreshFieldTexts()
    afterEdit("Edited step " .. tostring(indexOf(e)))
end

local function toggleDisabled()
    local e = view.selected
    if not e or not canRestructure(e) then return end
    e.disabled = (not e.disabled) or nil
    selectEntry(e)
    afterEdit((e.disabled and "Disabled" or "Enabled") .. " step " .. tostring(indexOf(e)))
end

local function deleteStep()
    local e = view.selected
    if not e or not canRestructure(e) then return end
    local i = indexOf(e)
    table.remove(view.macro.entries, i)
    view.selected = nil
    selectEntry(nil)
    afterEdit("Deleted step " .. tostring(i))
end

local function moveStep(dir)
    local e = view.selected
    if not e then return end
    local list = view.macro.entries
    local i = indexOf(e)
    local j = i + dir
    if not list[j] then return end
    if not canRestructure(e) or not canRestructure(list[j]) then return end
    -- swap the actions but keep the time slots, so timing stays in order
    list[i], list[j] = list[j], list[i]
    list[i].t, list[j].t = list[j].t, list[i].t
    selectEntry(e)
    afterEdit("Moved step to " .. tostring(j))
end

local shiftBox

local function shiftLater()
    local e = view.selected
    if not e or not canEditFields(e) then return end
    local dx = tonumber(shiftBox and shiftBox.Text)
    if not dx then say("Enter seconds to shift by (e.g. 1.5 or -0.5).", C.bad) return end
    local list = view.macro.entries
    for j = indexOf(e), #list do
        if list[j].t then list[j].t = math.max(0, list[j].t + dx) end
    end
    refreshFieldTexts()
    afterEdit(string.format("Shifted steps from %d on by %+.2fs", indexOf(e), dx))
end

function selectEntry(e)
    view.selected = e
    clearEditPanel()
    if not e then
        editTitle.Text = "Select a step to edit it."
        editTitle.TextColor3 = C.dim
        return
    end

    editTitle.Text = string.format("Step %d - %s%s", indexOf(e) or 0, describe(e), e.disabled and "  [DISABLED]" or "")
    editTitle.TextColor3 = e.disabled and C.skip or C.text

    for i, spec in ipairs(specsFor(e)) do
        local y = (i - 1) * 22
        label(fieldHolder, spec.name, UDim2.fromOffset(8, y), UDim2.fromOffset(80, 20), { TextColor3 = C.dim })
        local box = make("TextBox", {
            Position = UDim2.fromOffset(90, y), Size = UDim2.new(1, -98, 0, 20), BackgroundColor3 = C.row,
            TextColor3 = C.text, Font = Enum.Font.Code, TextSize = 12, ClearTextOnFocus = false,
            TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0, Text = "",
        }, fieldHolder)
        corner(box, 3)
        table.insert(fieldRows, { spec = spec, box = box })
    end
    refreshFieldTexts()

    local function ab(text, x, w, cb)
        local b = button(edit, text, UDim2.fromOffset(x, 154), UDim2.fromOffset(w, 24), cb)
        table.insert(actionButtons, b)
        return b
    end
    ab("Apply", 6, 70, applyFields)
    ab(e.disabled and "Enable" or "Disable", 80, 76, toggleDisabled)
    ab("Delete", 160, 70, deleteStep)
    ab("Up", 234, 50, function() moveStep(-1) end)
    ab("Down", 288, 56, function() moveStep(1) end)

    local sl = label(edit, "Shift this + later steps by", UDim2.fromOffset(8, 182), UDim2.fromOffset(170, 20), { TextColor3 = C.dim })
    table.insert(actionButtons, sl)
    shiftBox = make("TextBox", {
        Position = UDim2.fromOffset(182, 182), Size = UDim2.fromOffset(60, 20), BackgroundColor3 = C.row, Text = "0.5",
        TextColor3 = C.text, Font = Enum.Font.Code, TextSize = 12, ClearTextOnFocus = false, BorderSizePixel = 0,
    }, edit)
    corner(shiftBox, 3)
    table.insert(actionButtons, shiftBox)
    local sb = button(edit, "s  Apply shift", UDim2.fromOffset(246, 182), UDim2.fromOffset(110, 20), shiftLater)
    table.insert(actionButtons, sb)
end


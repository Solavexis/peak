local function make(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function corner(o, r) make("UICorner", { CornerRadius = UDim.new(0, r or 4) }, o) end

local function label(parent, text, pos, size, props)
    local l = make("TextLabel", {
        BackgroundTransparency = 1, Text = text, Position = pos, Size = size,
        TextColor3 = C.text, Font = Enum.Font.Code, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
    }, parent)
    for k, v in pairs(props or {}) do l[k] = v end
    return l

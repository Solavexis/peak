-- Result helpers
---------------------------------------------------------------------
local function success(data) return { Success = true, Data = data } end
local function makeError(msg, code) return { Success = false, Error = msg, Code = code or "ERROR" } end

---------------------------------------------------------------------
-- Place checks
---------------------------------------------------------------------
function M.IsLobby() return game.PlaceId == M.Places.Lobby end
function M.IsGame()  return game.PlaceId == M.Places.Game end

local function requireLobby()
    if not M.IsLobby() then return makeError("Only usable in the lobby.", "WRONG_PLACE") end
end
local function requireGame()
    if not M.IsGame() then return makeError("Only usable in-game.", "WRONG_PLACE") end
end

---------------------------------------------------------------------
-- Remote resolution
---------------------------------------------------------------------
local PATHS = {
    LobbyMessage = { "Remotes", "Message" },
    InteractItem = { "Remotes", "InteractItem" },
    GetData      = { "Remotes", "GetData" },
    Elevator     = { "Remotes", "Elevator" },

    Vote         = { "Events", "Game", "Vote" },
    Skip         = { "Events", "Game", "Skip" },
    PlaceTower   = { "Events", "Game", "PlaceTower" },
    Pause        = { "Events", "Game", "PauseGame" },
    Restart      = { "Events", "Game", "Restart" },
    Ability      = { "Events", "Towers", "Ability" },
    GameMessage  = { "Events", "Other", "Message" },
}

local remoteCache = {}
local function getRemote(name, timeout)
    local cached = remoteCache[name]
    if cached and cached.Parent then return cached end
    local inst = RS
    for _, n in ipairs(PATHS[name]) do
        inst = inst:WaitForChild(n, timeout or 5)
        if not inst then return nil end
    end
    remoteCache[name] = inst
    return inst
end

-- threads currently making calls on behalf of the API (so the recorder ignores them)
local internal = setmetatable({}, { __mode = "k" })

local function call(name, method, ...)
    local remote = getRemote(name)
    if not remote then return makeError("Remote '" .. name .. "' not found.", "REMOTE_NOT_FOUND") end
    local th = coroutine.running()
    internal[th] = true
    local res = table.pack(pcall(remote[method], remote, ...))
    internal[th] = nil
    if not res[1] then return makeError(tostring(res[2]), "REMOTE_ERROR") end
    local out = success(res[2])
    out.Raw = { table.unpack(res, 2, res.n) }
    return out
end

